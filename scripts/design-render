function validateLink(url) {
  const str2 = url.trim().toLowerCase();
  return BAD_PROTO_RE.test(str2) ? GOOD_DATA_RE.test(str2) : true;
}
var RECODE_HOSTNAME_FOR = ["http:", "https:", "mailto:"];
function normalizeLink(url) {
  const parsed = parse_default(url, true);
  if (parsed.hostname) {
    if (!parsed.protocol || RECODE_HOSTNAME_FOR.indexOf(parsed.protocol) >= 0) {
      try {
        parsed.hostname = import_punycode.default.toASCII(parsed.hostname);
      } catch (er) {
      }
    }
  }
  return encode_default(format(parsed));
}
function normalizeLinkText(url) {
  const parsed = parse_default(url, true);
  if (parsed.hostname) {
    if (!parsed.protocol || RECODE_HOSTNAME_FOR.indexOf(parsed.protocol) >= 0) {
      try {
        parsed.hostname = import_punycode.default.toUnicode(parsed.hostname);
      } catch (er) {
      }
    }
  }
  return decode_default(format(parsed), decode_default.defaultChars + "%");
}
function MarkdownIt(presetName, options3) {
  if (!(this instanceof MarkdownIt)) {
    return new MarkdownIt(presetName, options3);
  }
  if (!options3) {
    if (!isString(presetName)) {
      options3 = presetName || {};
      presetName = "default";
    }
  }
  this.inline = new parser_inline_default();
  this.block = new parser_block_default();
  this.core = new parser_core_default();
  this.renderer = new renderer_default();
  this.linkify = new linkify_it_default();
  this.validateLink = validateLink;
  this.normalizeLink = normalizeLink;
  this.normalizeLinkText = normalizeLinkText;
  this.utils = utils_exports;
  this.helpers = assign({}, helpers_exports);
  this.options = {};
  this.configure(presetName);
  if (options3) {
    this.set(options3);
  }
}
MarkdownIt.prototype.set = function(options3) {
  assign(this.options, options3);
  return this;
};
MarkdownIt.prototype.configure = function(presets) {
  const self2 = this;
  if (isString(presets)) {
    const presetName = presets;
    presets = config[presetName];
    if (!presets) {
      throw new Error('Wrong `markdown-it` preset "' + presetName + '", check name');
    }
  }
  if (!presets) {
    throw new Error("Wrong `markdown-it` preset, can't be empty");
  }
  if (presets.options) {
    self2.set(presets.options);
  }
  if (presets.components) {
    Object.keys(presets.components).forEach(function(name) {
      if (presets.components[name].rules) {
        self2[name].ruler.enableOnly(presets.components[name].rules);
      }
      if (presets.components[name].rules2) {
        self2[name].ruler2.enableOnly(presets.components[name].rules2);
      }
    });
  }
  return this;
};
MarkdownIt.prototype.enable = function(list3, ignoreInvalid) {
  let result = [];
  if (!Array.isArray(list3)) {
    list3 = [list3];
  }
  ["core", "block", "inline"].forEach(function(chain) {
    result = result.concat(this[chain].ruler.enable(list3, true));
  }, this);
  result = result.concat(this.inline.ruler2.enable(list3, true));
  const missed = list3.filter(function(name) {
    return result.indexOf(name) < 0;
  });
  if (missed.length && !ignoreInvalid) {
    throw new Error("MarkdownIt. Failed to enable unknown rule(s): " + missed);
  }
  return this;
};
MarkdownIt.prototype.disable = function(list3, ignoreInvalid) {
  let result = [];
  if (!Array.isArray(list3)) {
    list3 = [list3];
  }
  ["core", "block", "inline"].forEach(function(chain) {
    result = result.concat(this[chain].ruler.disable(list3, true));
  }, this);
  result = result.concat(this.inline.ruler2.disable(list3, true));
  const missed = list3.filter(function(name) {
    return result.indexOf(name) < 0;
  });
  if (missed.length && !ignoreInvalid) {
    throw new Error("MarkdownIt. Failed to disable unknown rule(s): " + missed);
  }
  return this;
};
MarkdownIt.prototype.use = function(plugin22) {
  const args = [this].concat(Array.prototype.slice.call(arguments, 1));
  plugin22.apply(plugin22, args);
  return this;
};
MarkdownIt.prototype.parse = function(src, env) {
  if (typeof src !== "string") {
    throw new Error("Input data should be a String");
  }
  const state4 = new this.core.State(src, this, env);
  this.core.process(state4);
  return state4.tokens;
};
MarkdownIt.prototype.render = function(src, env) {
  env = env || {};
  return this.renderer.render(this.parse(src, env), this.options, env);
};
MarkdownIt.prototype.parseInline = function(src, env) {
  const state4 = new this.core.State(src, this, env);
  state4.inlineMode = true;
  this.core.process(state4);
  return state4.tokens;
};
MarkdownIt.prototype.renderInline = function(src, env) {
  env = env || {};
  return this.renderer.render(this.parseInline(src, env), this.options, env);
};
var lib_default = MarkdownIt;

// node_modules/markdown-it-container/index.mjs
function container_plugin(md, name, options3) {
  function validateDefault(params) {
    return params.trim().split(" ", 2)[0] === name;
  }
  function renderDefault(tokens2, idx, _options, env, slf) {
    if (tokens2[idx].nesting === 1) {
      tokens2[idx].attrJoin("class", name);
    }
    return slf.renderToken(tokens2, idx, _options, env, slf);
  }
  options3 = options3 || {};
  const min_markers = 3;
  const marker_str = options3.marker || ":";
  const marker_char = marker_str.charCodeAt(0);
  const marker_len = marker_str.length;
  const validate2 = options3.validate || validateDefault;
  const render7 = options3.render || renderDefault;
  function container2(state4, startLine, endLine, silent) {
    let pos;
    let auto_closed = false;
    let start3 = state4.bMarks[startLine] + state4.tShift[startLine];
    let max9 = state4.eMarks[startLine];
    if (marker_char !== state4.src.charCodeAt(start3)) {
      return false;
    }
    for (pos = start3 + 1; pos <= max9; pos++) {
      if (marker_str[(pos - start3) % marker_len] !== state4.src[pos]) {
        break;
      }
    }
    const marker_count = Math.floor((pos - start3) / marker_len);
    if (marker_count < min_markers) {
      return false;
    }
    pos -= (pos - start3) % marker_len;
    const markup = state4.src.slice(start3, pos);
    const params = state4.src.slice(pos, max9);
    if (!validate2(params, markup)) {
      return false;
    }
    if (silent) {
      return true;
    }
    let nextLine = startLine;
    for (; ; ) {
      nextLine++;
      if (nextLine >= endLine) {
        break;
      }
      start3 = state4.bMarks[nextLine] + state4.tShift[nextLine];
      max9 = state4.eMarks[nextLine];
      if (start3 < max9 && state4.sCount[nextLine] < state4.blkIndent) {
        break;
      }
      if (marker_char !== state4.src.charCodeAt(start3)) {
        continue;
      }
      if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
        continue;
      }
      for (pos = start3 + 1; pos <= max9; pos++) {
        if (marker_str[(pos - start3) % marker_len] !== state4.src[pos]) {
          break;
        }
      }
      if (Math.floor((pos - start3) / marker_len) < marker_count) {
        continue;
      }
      pos -= (pos - start3) % marker_len;
      pos = state4.skipSpaces(pos);
      if (pos < max9) {
        continue;
      }
      auto_closed = true;
      break;
    }
    const old_parent = state4.parentType;
    const old_line_max = state4.lineMax;
    state4.parentType = "container";
    state4.lineMax = nextLine;
    const token_o = state4.push("container_" + name + "_open", "div", 1);
    token_o.markup = markup;
    token_o.block = true;
    token_o.info = params;
    token_o.map = [startLine, nextLine];
    state4.md.block.tokenize(state4, startLine + 1, nextLine);
    const token_c = state4.push("container_" + name + "_close", "div", -1);
    token_c.markup = state4.src.slice(start3, pos);
    token_c.block = true;
    state4.parentType = old_parent;
    state4.lineMax = old_line_max;
    state4.line = nextLine + (auto_closed ? 1 : 0);
    return true;
  }
  md.block.ruler.before("fence", "container_" + name, container2, {
    alt: ["paragraph", "reference", "blockquote", "list"]
  });
  md.renderer.rules["container_" + name + "_open"] = render7;
  md.renderer.rules["container_" + name + "_close"] = render7;
}

