function streamContents(node2, options3) {
  if (!node2) {
    throw new Error("Node must be an AstNode.");
  }
  const range3 = options3 === null || options3 === void 0 ? void 0 : options3.range;
  return new StreamImpl(() => ({
    keys: Object.keys(node2),
    keyIndex: 0,
    arrayIndex: 0
  }), (state4) => {
    while (state4.keyIndex < state4.keys.length) {
      const property4 = state4.keys[state4.keyIndex];
      if (!property4.startsWith("$")) {
        const value = node2[property4];
        if (isAstNode(value)) {
          state4.keyIndex++;
          if (isAstNodeInRange(value, range3)) {
            return { done: false, value };
          }
        } else if (Array.isArray(value)) {
          while (state4.arrayIndex < value.length) {
            const index = state4.arrayIndex++;
            const element3 = value[index];
            if (isAstNode(element3) && isAstNodeInRange(element3, range3)) {
              return { done: false, value: element3 };
            }
          }
          state4.arrayIndex = 0;
        }
      }
      state4.keyIndex++;
    }
    return DONE_RESULT;
  });
}
function streamAllContents(root5, options3) {
