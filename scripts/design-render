function intersectEllipse(node2, rx, ry, point8) {
  var cx = node2.x;
  var cy = node2.y;
  var px = cx - point8.x;
  var py = cy - point8.y;
  var det = Math.sqrt(rx * rx * py * py + ry * ry * px * px);
  var dx = Math.abs(rx * ry * px / det);
  if (point8.x < cx) {
    dx = -dx;
  }
  var dy = Math.abs(rx * ry * py / det);
  if (point8.y < cy) {
    dy = -dy;
  }
  return { x: cx + dx, y: cy + dy };
}
