    limitForce = function limitForce2(forceX, forceY, max9) {
      var force = Math.sqrt(forceX * forceX + forceY * forceY);
      if (force > max9) {
        var res = {
          x: max9 * forceX / force,
          y: max9 * forceY / force
        };
