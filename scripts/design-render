// node_modules/dagre-d3-es/src/dagre/order/add-subgraph-constraints.js
function addSubgraphConstraints(g, cg, vs) {
  var prev2 = {}, rootPrev;
  forEach_default(vs, function(v) {
    var child = g.parent(v), parent4, prevChild;
    while (child) {
      parent4 = g.parent(child);
      if (parent4) {
        prevChild = prev2[parent4];
        prev2[parent4] = child;
      } else {
        prevChild = rootPrev;
        rootPrev = child;
      }
      if (prevChild && prevChild !== child) {
        cg.setEdge(prevChild, child);
        return;
      }
      child = parent4;
    }
  });
}
