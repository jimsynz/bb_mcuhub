// node_modules/dagre-d3-es/src/dagre/rank/feasible-tree.js
function feasibleTree(g) {
  var t = new Graph({ directed: false });
  var start3 = g.nodes()[0];
  var size5 = g.nodeCount();
  t.setNode(start3, {});
  var edge, delta;
  while (tightTree(t, g) < size5) {
    edge = findMinSlackEdge(t, g);
    delta = t.hasNode(edge.v) ? slack(g, edge) : -slack(g, edge);
    shiftRanks(t, g, delta);
  }
  return t;
}
function tightTree(t, g) {
  function dfs3(v) {
    forEach_default(g.nodeEdges(v), function(e) {
      var edgeV = e.v, w2 = v === edgeV ? e.w : edgeV;
      if (!t.hasNode(w2) && !slack(g, e)) {
        t.setNode(w2, {});
        t.setEdge(v, w2, {});
        dfs3(w2);
      }
    });
  }
  forEach_default(t.nodes(), dfs3);
  return t.nodeCount();
}
function findMinSlackEdge(t, g) {
  return minBy_default(g.edges(), function(e) {
    if (t.hasNode(e.v) !== t.hasNode(e.w)) {
      return slack(g, e);
    }
  });
}
function shiftRanks(t, g, delta) {
  forEach_default(t.nodes(), function(v) {
    g.node(v).rank += delta;
  });
}
