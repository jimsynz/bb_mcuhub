// node_modules/khroma/dist/channels/index.js
var Channels, channels_default;
var init_channels = __esm({
  "node_modules/khroma/dist/channels/index.js"() {
    init_utils2();
    init_type();
    init_constants2();
    Channels = class {
      /* CONSTRUCTOR */
      constructor(data6, color2) {
        this.color = color2;
        this.changed = false;
        this.data = data6;
        this.type = new type_default();
      }
      /* API */
      set(data6, color2) {
        this.color = color2;
        this.changed = false;
        this.data = data6;
        this.type.type = TYPE.ALL;
        return this;
      }
      /* HELPERS */
      _ensureHSL() {
        const data6 = this.data;
        const { h, s, l } = data6;
        if (h === void 0)
          data6.h = utils_default.channel.rgb2hsl(data6, "h");
        if (s === void 0)
          data6.s = utils_default.channel.rgb2hsl(data6, "s");
        if (l === void 0)
          data6.l = utils_default.channel.rgb2hsl(data6, "l");
      }
      _ensureRGB() {
        const data6 = this.data;
        const { r, g, b } = data6;
        if (r === void 0)
          data6.r = utils_default.channel.hsl2rgb(data6, "r");
        if (g === void 0)
          data6.g = utils_default.channel.hsl2rgb(data6, "g");
        if (b === void 0)
          data6.b = utils_default.channel.hsl2rgb(data6, "b");
      }
      /* GETTERS */
      get r() {
        const data6 = this.data;
        const r = data6.r;
        if (!this.type.is(TYPE.HSL) && r !== void 0)
          return r;
        this._ensureHSL();
        return utils_default.channel.hsl2rgb(data6, "r");
      }
      get g() {
        const data6 = this.data;
        const g = data6.g;
        if (!this.type.is(TYPE.HSL) && g !== void 0)
          return g;
        this._ensureHSL();
        return utils_default.channel.hsl2rgb(data6, "g");
      }
      get b() {
        const data6 = this.data;
        const b = data6.b;
        if (!this.type.is(TYPE.HSL) && b !== void 0)
          return b;
        this._ensureHSL();
        return utils_default.channel.hsl2rgb(data6, "b");
      }
      get h() {
        const data6 = this.data;
        const h = data6.h;
        if (!this.type.is(TYPE.RGB) && h !== void 0)
          return h;
        this._ensureRGB();
        return utils_default.channel.rgb2hsl(data6, "h");
      }
      get s() {
        const data6 = this.data;
        const s = data6.s;
        if (!this.type.is(TYPE.RGB) && s !== void 0)
          return s;
        this._ensureRGB();
        return utils_default.channel.rgb2hsl(data6, "s");
      }
      get l() {
        const data6 = this.data;
        const l = data6.l;
        if (!this.type.is(TYPE.RGB) && l !== void 0)
          return l;
        this._ensureRGB();
        return utils_default.channel.rgb2hsl(data6, "l");
      }
      get a() {
        return this.data.a;
      }
      /* SETTERS */
      set r(r) {
        this.type.set(TYPE.RGB);
        this.changed = true;
        this.data.r = r;
      }
      set g(g) {
        this.type.set(TYPE.RGB);
        this.changed = true;
        this.data.g = g;
      }
      set b(b) {
        this.type.set(TYPE.RGB);
        this.changed = true;
        this.data.b = b;
      }
      set h(h) {
        this.type.set(TYPE.HSL);
        this.changed = true;
        this.data.h = h;
      }
      set s(s) {
        this.type.set(TYPE.HSL);
        this.changed = true;
        this.data.s = s;
      }
      set l(l) {
        this.type.set(TYPE.HSL);
        this.changed = true;
        this.data.l = l;
      }
      set a(a) {
        this.changed = true;
        this.data.a = a;
      }
    };
    channels_default = Channels;
  }
