function streamAst(root5, options3) {
  if (!root5) {
    throw new Error("Root node must be an AstNode.");
  } else if ((options3 === null || options3 === void 0 ? void 0 : options3.range) && !isAstNodeInRange(root5, options3.range)) {
    return new TreeStreamImpl(root5, () => []);
  }
  return new TreeStreamImpl(root5, (node2) => streamContents(node2, options3), { includeRoot: true });
}
function isAstNodeInRange(astNode, range3) {
  var _a3;
  if (!range3) {
    return true;
  }
  const nodeRange = (_a3 = astNode.$cstNode) === null || _a3 === void 0 ? void 0 : _a3.range;
  if (!nodeRange) {
    return false;
  }
  return inRange(nodeRange, range3);
}
function streamReferences(node2) {
  return new StreamImpl(() => ({
    keys: Object.keys(node2),
    keyIndex: 0,
    arrayIndex: 0
  }), (state4) => {
    while (state4.keyIndex < state4.keys.length) {
      const property4 = state4.keys[state4.keyIndex];
      if (!property4.startsWith("$")) {
        const value = node2[property4];
        if (isReference(value)) {
          state4.keyIndex++;
          return { done: false, value: { reference: value, container: node2, property: property4 } };
        } else if (Array.isArray(value)) {
          while (state4.arrayIndex < value.length) {
            const index = state4.arrayIndex++;
            const element3 = value[index];
            if (isReference(element3)) {
              return { done: false, value: { reference: element3, container: node2, property: property4, index } };
            }
          }
          state4.arrayIndex = 0;
        }
      }
      state4.keyIndex++;
    }
    return DONE_RESULT;
  });
}
function findLocalReferences(targetNode, lookup2 = getDocument(targetNode).parseResult.value) {
  const refs3 = [];
  streamAst(lookup2).forEach((node2) => {
    streamReferences(node2).forEach((refInfo) => {
      if (refInfo.reference.ref === targetNode) {
        refs3.push(refInfo.reference);
      }
    });
  });
  return stream(refs3);
}
function assignMandatoryProperties(reflection3, node2) {
  const typeMetaData = reflection3.getTypeMetaData(node2.$type);
  const genericNode = node2;
  for (const property4 of typeMetaData.properties) {
    if (property4.defaultValue !== void 0 && genericNode[property4.name] === void 0) {
      genericNode[property4.name] = copyDefaultValue(property4.defaultValue);
    }
  }
}
function copyDefaultValue(propertyType) {
  if (Array.isArray(propertyType)) {
    return [...propertyType.map(copyDefaultValue)];
  } else {
    return propertyType;
  }
}
function copyAstNode(node2, buildReference) {
  const copy5 = { $type: node2.$type };
  for (const [name, value] of Object.entries(node2)) {
    if (!name.startsWith("$")) {
      if (isAstNode(value)) {
        copy5[name] = copyAstNode(value, buildReference);
      } else if (isReference(value)) {
        copy5[name] = buildReference(copy5, name, value.$refNode, value.$refText);
      } else if (Array.isArray(value)) {
        const copiedArray = [];
        for (const element3 of value) {
          if (isAstNode(element3)) {
            copiedArray.push(copyAstNode(element3, buildReference));
          } else if (isReference(element3)) {
            copiedArray.push(buildReference(copy5, name, element3.$refNode, element3.$refText));
          } else {
            copiedArray.push(element3);
          }
        }
        copy5[name] = copiedArray;
      } else {
        copy5[name] = value;
      }
    }
  }
  linkContentToContainer(copy5);
  return copy5;
}
