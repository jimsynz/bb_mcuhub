function readTagProperty(state4) {
  var _position, isVerbatim = false, isNamed2 = false, tagHandle, tagName19, ch;
  ch = state4.input.charCodeAt(state4.position);
  if (ch !== 33) return false;
  if (state4.tag !== null) {
    throwError(state4, "duplication of a tag property");
  }
  ch = state4.input.charCodeAt(++state4.position);
  if (ch === 60) {
    isVerbatim = true;
    ch = state4.input.charCodeAt(++state4.position);
  } else if (ch === 33) {
    isNamed2 = true;
    tagHandle = "!!";
    ch = state4.input.charCodeAt(++state4.position);
  } else {
    tagHandle = "!";
  }
  _position = state4.position;
  if (isVerbatim) {
    do {
      ch = state4.input.charCodeAt(++state4.position);
    } while (ch !== 0 && ch !== 62);
