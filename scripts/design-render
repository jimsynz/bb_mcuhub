  const { cssStyles } = node2;
  const points = [
    ...generateCirclePoints2(w2 / 2, -h / 2, radius2, 30, -90, 0),
    { x: -w2 / 2 - radius2, y: radius2 },
    ...generateCirclePoints2(w2 / 2 + radius2 * 2, -radius2, radius2, 20, -180, -270),
    ...generateCirclePoints2(w2 / 2 + radius2 * 2, radius2, radius2, 20, -90, -180),
    { x: -w2 / 2 - radius2, y: -h / 2 },
    ...generateCirclePoints2(w2 / 2, h / 2, radius2, 20, 0, 90)
  ];
  const rectPoints = [
    { x: w2 / 2, y: -h / 2 - radius2 },
    { x: -w2 / 2, y: -h / 2 - radius2 },
    ...generateCirclePoints2(w2 / 2, -h / 2, radius2, 20, -90, 0),
    { x: -w2 / 2 - radius2, y: -radius2 },
    ...generateCirclePoints2(w2 / 2 + w2 * 0.1, -radius2, radius2, 20, -180, -270),
    ...generateCirclePoints2(w2 / 2 + w2 * 0.1, radius2, radius2, 20, -90, -180),
    { x: -w2 / 2 - radius2, y: h / 2 },
    ...generateCirclePoints2(w2 / 2, h / 2, radius2, 20, 0, 90),
    { x: -w2 / 2, y: h / 2 + radius2 },
    { x: w2 / 2, y: h / 2 + radius2 }
  ];
  const rc = import_roughjs8.default.svg(shapeSvg);
  const options3 = userNodeOverrides(node2, { fill: "none" });
  if (node2.look !== "handDrawn") {
    options3.roughness = 0;
    options3.fillStyle = "solid";
