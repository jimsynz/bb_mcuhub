  const { cssStyles } = node2;
  const leftCurlyBracePoints = [
    ...generateCirclePoints4(w2 / 2, -h / 2, radius2, 30, -90, 0),
    { x: -w2 / 2 - radius2, y: radius2 },
    ...generateCirclePoints4(w2 / 2 + radius2 * 2, -radius2, radius2, 20, -180, -270),
    ...generateCirclePoints4(w2 / 2 + radius2 * 2, radius2, radius2, 20, -90, -180),
