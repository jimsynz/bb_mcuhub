      lastIdx = i2 + 1;
    } else {
      ret += `${str2.substring(lastIdx, i2)}&#x${getCodePoint(str2, i2).toString(16)};`;
      lastIdx = xmlReplacer.lastIndex += Number((char2 & 64512) === 55296);
    }
  }
  return ret + str2.substr(lastIdx);
}
