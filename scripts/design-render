    let height2 = ySize * (maxHeight + padding) + padding;
    if (width3 < siblingWidth) {
      log.debug(
        `Detected to small siebling: abc95 ${block4.id} sieblingWidth ${siblingWidth} sieblingHeight ${siblingHeight} width ${width3}`
      );
      width3 = siblingWidth;
      height2 = siblingHeight;
      const childWidth = (siblingWidth - xSize * padding - padding) / xSize;
      const childHeight = (siblingHeight - ySize * padding - padding) / ySize;
      log.debug("Size indata abc88", block4.id, "childWidth", childWidth, "maxWidth", maxWidth);
      log.debug("Size indata abc88", block4.id, "childHeight", childHeight, "maxHeight", maxHeight);
      log.debug("Size indata abc88 xSize", xSize, "padding", padding);
      for (const child of block4.children) {
        if (child.size) {
          child.size.width = childWidth;
          child.size.height = childHeight;
          child.size.x = 0;
          child.size.y = 0;
        }
      }
    }
    log.debug(
      `abc95 (finale calc) ${block4.id} xSize ${xSize} ySize ${ySize} columns ${columns}${block4.children.length} width=${Math.max(width3, block4.size?.width || 0)}`
    );
    if (width3 < (block4?.size?.width || 0)) {
      width3 = block4?.size?.width || 0;
      const num = columns > 0 ? Math.min(block4.children.length, columns) : block4.children.length;
      if (num > 0) {
        const childWidth = (width3 - num * padding - padding) / num;
        log.debug("abc95 (growing to fit) width", block4.id, width3, block4.size?.width, childWidth);
        for (const child of block4.children) {
          if (child.size) {
            child.size.width = childWidth;
          }
        }
      }
    }
    block4.size = {
      width: width3,
      height: height2,
      x: 0,
      y: 0
    };
  }
  log.debug(
    "setBlockSizes abc94 (done)",
    block4.id,
    block4?.size?.x,
    block4?.size?.width,
    block4?.size?.y,
    block4?.size?.height
  );
}
function layoutBlocks(block4, db22) {
  log.debug(
    `abc85 layout blocks (=>layoutBlocks) ${block4.id} x: ${block4?.size?.x} y: ${block4?.size?.y} width: ${block4?.size?.width}`
  );
  const columns = block4.columns ?? -1;
  log.debug("layoutBlocks columns abc95", block4.id, "=>", columns, block4);
  if (block4.children && // find max width of children
  block4.children.length > 0) {
    const width3 = block4?.children[0]?.size?.width ?? 0;
    const widthOfChildren = block4.children.length * width3 + (block4.children.length - 1) * padding;
    log.debug("widthOfChildren 88", widthOfChildren, "posX");
    let columnPos = 0;
    log.debug("abc91 block?.size?.x", block4.id, block4?.size?.x);
    let startingPosX = block4?.size?.x ? block4?.size?.x + (-block4?.size?.width / 2 || 0) : -padding;
    let rowPos = 0;
    for (const child of block4.children) {
      const parent4 = block4;
      if (!child.size) {
        continue;
      }
      const { width: width22, height: height2 } = child.size;
      const { px, py } = calculateBlockPosition(columns, columnPos);
      if (py != rowPos) {
        rowPos = py;
        startingPosX = block4?.size?.x ? block4?.size?.x + (-block4?.size?.width / 2 || 0) : -padding;
        log.debug("New row in layout for block", block4.id, " and child ", child.id, rowPos);
      }
      log.debug(
        `abc89 layout blocks (child) id: ${child.id} Pos: ${columnPos} (px, py) ${px},${py} (${parent4?.size?.x},${parent4?.size?.y}) parent: ${parent4.id} width: ${width22}${padding}`
      );
      if (parent4.size) {
        const halfWidth = width22 / 2;
        child.size.x = startingPosX + padding + halfWidth;
        log.debug(
          `abc91 layout blocks (calc) px, pyid:${child.id} startingPos=X${startingPosX} new startingPosX${child.size.x} ${halfWidth} padding=${padding} width=${width22} halfWidth=${halfWidth} => x:${child.size.x} y:${child.size.y} ${child.widthInColumns} (width * (child?.w || 1)) / 2 ${width22 * (child?.widthInColumns ?? 1) / 2}`
        );
        startingPosX = child.size.x + halfWidth;
        child.size.y = parent4.size.y - parent4.size.height / 2 + py * (height2 + padding) + height2 / 2 + padding;
        log.debug(
          `abc88 layout blocks (calc) px, pyid:${child.id}startingPosX${startingPosX}${padding}${halfWidth}=>x:${child.size.x}y:${child.size.y}${child.widthInColumns}(width * (child?.w || 1)) / 2${width22 * (child?.widthInColumns ?? 1) / 2}`
        );
      }
      if (child.children) {
        layoutBlocks(child, db22);
      }
      columnPos += child?.widthInColumns ?? 1;
      log.debug("abc88 columnsPos", child, columnPos);
    }
  }
  log.debug(
    `layout blocks (<==layoutBlocks) ${block4.id} x: ${block4?.size?.x} y: ${block4?.size?.y} width: ${block4?.size?.width}`
  );
}
function findBounds(block4, { minX, minY, maxX, maxY } = { minX: 0, minY: 0, maxX: 0, maxY: 0 }) {
  if (block4.size && block4.id !== "root") {
    const { x: x3, y: y3, width: width3, height: height2 } = block4.size;
    if (x3 - width3 / 2 < minX) {
      minX = x3 - width3 / 2;
    }
    if (y3 - height2 / 2 < minY) {
      minY = y3 - height2 / 2;
    }
    if (x3 + width3 / 2 > maxX) {
      maxX = x3 + width3 / 2;
    }
    if (y3 + height2 / 2 > maxY) {
      maxY = y3 + height2 / 2;
    }
  }
  if (block4.children) {
    for (const child of block4.children) {
      ({ minX, minY, maxX, maxY } = findBounds(child, { minX, minY, maxX, maxY }));
    }
  }
  return { minX, minY, maxX, maxY };
}
function layout5(db22) {
