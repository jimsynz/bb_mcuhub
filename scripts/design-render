  const height2 = Math.max(35, node2?.height ?? 0);
  const gap = 7;
  const points = [
    { x: width3, y: 0 },
    { x: 0, y: height2 + gap / 2 },
    { x: width3 - 2 * gap, y: height2 + gap / 2 },
    { x: 0, y: 2 * height2 },
    { x: width3, y: height2 - gap / 2 },
    { x: 2 * gap, y: height2 - gap / 2 }
  ];
