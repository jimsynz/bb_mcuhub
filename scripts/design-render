// node_modules/markdown-it/lib/rules_core/linkify.mjs
function isLinkOpen(str2) {
  return /^<a[>\s]/i.test(str2);
}
function isLinkClose(str2) {
  return /^<\/a\s*>/i.test(str2);
}
function linkify(state4) {
  const blockTokens = state4.tokens;
  if (!state4.md.options.linkify) {
    return;
  }
  for (let j = 0, l = blockTokens.length; j < l; j++) {
    if (blockTokens[j].type !== "inline" || !state4.md.linkify.pretest(blockTokens[j].content)) {
      continue;
    }
    let tokens2 = blockTokens[j].children;
    let htmlLinkLevel = 0;
    for (let i2 = tokens2.length - 1; i2 >= 0; i2--) {
      const currentToken = tokens2[i2];
      if (currentToken.type === "link_close") {
        i2--;
        while (tokens2[i2].level !== currentToken.level && tokens2[i2].type !== "link_open") {
          i2--;
        }
        continue;
      }
      if (currentToken.type === "html_inline") {
        if (isLinkOpen(currentToken.content) && htmlLinkLevel > 0) {
          htmlLinkLevel--;
        }
        if (isLinkClose(currentToken.content)) {
          htmlLinkLevel++;
        }
      }
      if (htmlLinkLevel > 0) {
        continue;
      }
      if (currentToken.type === "text" && state4.md.linkify.test(currentToken.content)) {
        const text5 = currentToken.content;
        let links3 = state4.md.linkify.match(text5);
        const nodes6 = [];
        let level = currentToken.level;
        let lastPos = 0;
        if (links3.length > 0 && links3[0].index === 0 && i2 > 0 && tokens2[i2 - 1].type === "text_special") {
          links3 = links3.slice(1);
        }
        for (let ln = 0; ln < links3.length; ln++) {
          const url = links3[ln].url;
          const fullUrl = state4.md.normalizeLink(url);
          if (!state4.md.validateLink(fullUrl)) {
            continue;
          }
          let urlText = links3[ln].text;
          if (!links3[ln].schema) {
            urlText = state4.md.normalizeLinkText("http://" + urlText).replace(/^http:\/\//, "");
          } else if (links3[ln].schema === "mailto:" && !/^mailto:/i.test(urlText)) {
            urlText = state4.md.normalizeLinkText("mailto:" + urlText).replace(/^mailto:/, "");
          } else {
            urlText = state4.md.normalizeLinkText(urlText);
          }
          const pos = links3[ln].index;
          if (pos > lastPos) {
            const token2 = new state4.Token("text", "", 0);
            token2.content = text5.slice(lastPos, pos);
            token2.level = level;
            nodes6.push(token2);
          }
          const token_o = new state4.Token("link_open", "a", 1);
          token_o.attrs = [["href", fullUrl]];
          token_o.level = level++;
          token_o.markup = "linkify";
          token_o.info = "auto";
          nodes6.push(token_o);
          const token_t = new state4.Token("text", "", 0);
          token_t.content = urlText;
          token_t.level = level;
          nodes6.push(token_t);
          const token_c = new state4.Token("link_close", "a", -1);
          token_c.level = --level;
          token_c.markup = "linkify";
          token_c.info = "auto";
          nodes6.push(token_c);
          lastPos = links3[ln].lastIndex;
        }
        if (lastPos < text5.length) {
          const token2 = new state4.Token("text", "", 0);
          token2.content = text5.slice(lastPos);
          token2.level = level;
          nodes6.push(token2);
        }
        blockTokens[j].children = tokens2 = arrayReplaceAt(tokens2, i2, nodes6);
      }
    }
  }
}

// node_modules/markdown-it/lib/rules_core/replacements.mjs
var RARE_RE = /\+-|\.\.|\?\?\?\?|!!!!|,,|--/;
var SCOPED_ABBR_TEST_RE = /\((c|tm|r)\)/i;
var SCOPED_ABBR_RE = /\((c|tm|r)\)/ig;
var SCOPED_ABBR = {
  c: "\xA9",
  r: "\xAE",
  tm: "\u2122"
};
function replaceFn(match3, name) {
  return SCOPED_ABBR[name.toLowerCase()];
}
function replace_scoped(inlineTokens) {
  let inside_autolink = 0;
  for (let i2 = inlineTokens.length - 1; i2 >= 0; i2--) {
    const token2 = inlineTokens[i2];
    if (token2.type === "text" && !inside_autolink) {
      token2.content = token2.content.replace(SCOPED_ABBR_RE, replaceFn);
    }
    if (token2.type === "link_open" && token2.info === "auto") {
      inside_autolink--;
    }
    if (token2.type === "link_close" && token2.info === "auto") {
      inside_autolink++;
    }
  }
}
function replace_rare(inlineTokens) {
  let inside_autolink = 0;
  for (let i2 = inlineTokens.length - 1; i2 >= 0; i2--) {
    const token2 = inlineTokens[i2];
    if (token2.type === "text" && !inside_autolink) {
      if (RARE_RE.test(token2.content)) {
        token2.content = token2.content.replace(/\+-/g, "\xB1").replace(/\.{2,}/g, "\u2026").replace(/([?!])…/g, "$1..").replace(/([?!]){4,}/g, "$1$1$1").replace(/,{2,}/g, ",").replace(/(^|[^-])---(?=[^-]|$)/mg, "$1\u2014").replace(/(^|\s)--(?=\s|$)/mg, "$1\u2013").replace(/(^|[^-\s])--(?=[^-\s]|$)/mg, "$1\u2013");
      }
    }
    if (token2.type === "link_open" && token2.info === "auto") {
      inside_autolink--;
    }
    if (token2.type === "link_close" && token2.info === "auto") {
      inside_autolink++;
    }
  }
}
function replace(state4) {
  let blkIdx;
  if (!state4.md.options.typographer) {
    return;
  }
  for (blkIdx = state4.tokens.length - 1; blkIdx >= 0; blkIdx--) {
    if (state4.tokens[blkIdx].type !== "inline") {
      continue;
    }
    if (SCOPED_ABBR_TEST_RE.test(state4.tokens[blkIdx].content)) {
      replace_scoped(state4.tokens[blkIdx].children);
    }
    if (RARE_RE.test(state4.tokens[blkIdx].content)) {
      replace_rare(state4.tokens[blkIdx].children);
    }
  }
}

// node_modules/markdown-it/lib/rules_core/smartquotes.mjs
var QUOTE_TEST_RE = /['"]/;
var QUOTE_RE = /['"]/g;
var APOSTROPHE = "\u2019";
function replaceAt(str2, index, ch) {
  return str2.slice(0, index) + ch + str2.slice(index + 1);
}
function process_inlines(tokens2, state4) {
  let j;
  const stack = [];
  for (let i2 = 0; i2 < tokens2.length; i2++) {
    const token2 = tokens2[i2];
    const thisLevel = tokens2[i2].level;
    for (j = stack.length - 1; j >= 0; j--) {
      if (stack[j].level <= thisLevel) {
        break;
      }
    }
    stack.length = j + 1;
    if (token2.type !== "text") {
      continue;
    }
    let text5 = token2.content;
    let pos = 0;
    let max9 = text5.length;
    OUTER:
      while (pos < max9) {
        QUOTE_RE.lastIndex = pos;
        const t = QUOTE_RE.exec(text5);
        if (!t) {
          break;
        }
        let canOpen = true;
        let canClose = true;
        pos = t.index + 1;
        const isSingle = t[0] === "'";
        let lastChar = 32;
        if (t.index - 1 >= 0) {
          lastChar = text5.charCodeAt(t.index - 1);
        } else {
          for (j = i2 - 1; j >= 0; j--) {
            if (tokens2[j].type === "softbreak" || tokens2[j].type === "hardbreak") break;
            if (!tokens2[j].content) continue;
            lastChar = tokens2[j].content.charCodeAt(tokens2[j].content.length - 1);
            break;
          }
        }
        let nextChar = 32;
        if (pos < max9) {
          nextChar = text5.charCodeAt(pos);
        } else {
          for (j = i2 + 1; j < tokens2.length; j++) {
            if (tokens2[j].type === "softbreak" || tokens2[j].type === "hardbreak") break;
            if (!tokens2[j].content) continue;
            nextChar = tokens2[j].content.charCodeAt(0);
            break;
          }
        }
        const isLastPunctChar = isMdAsciiPunct(lastChar) || isPunctChar(String.fromCharCode(lastChar));
        const isNextPunctChar = isMdAsciiPunct(nextChar) || isPunctChar(String.fromCharCode(nextChar));
        const isLastWhiteSpace = isWhiteSpace(lastChar);
        const isNextWhiteSpace = isWhiteSpace(nextChar);
        if (isNextWhiteSpace) {
          canOpen = false;
        } else if (isNextPunctChar) {
          if (!(isLastWhiteSpace || isLastPunctChar)) {
            canOpen = false;
          }
        }
        if (isLastWhiteSpace) {
          canClose = false;
        } else if (isLastPunctChar) {
          if (!(isNextWhiteSpace || isNextPunctChar)) {
            canClose = false;
          }
        }
        if (nextChar === 34 && t[0] === '"') {
          if (lastChar >= 48 && lastChar <= 57) {
            canClose = canOpen = false;
          }
        }
        if (canOpen && canClose) {
          canOpen = isLastPunctChar;
          canClose = isNextPunctChar;
        }
        if (!canOpen && !canClose) {
          if (isSingle) {
            token2.content = replaceAt(token2.content, t.index, APOSTROPHE);
          }
          continue;
        }
        if (canClose) {
          for (j = stack.length - 1; j >= 0; j--) {
            let item = stack[j];
            if (stack[j].level < thisLevel) {
              break;
            }
            if (item.single === isSingle && stack[j].level === thisLevel) {
              item = stack[j];
              let openQuote;
              let closeQuote;
              if (isSingle) {
                openQuote = state4.md.options.quotes[2];
                closeQuote = state4.md.options.quotes[3];
              } else {
                openQuote = state4.md.options.quotes[0];
                closeQuote = state4.md.options.quotes[1];
              }
              token2.content = replaceAt(token2.content, t.index, closeQuote);
              tokens2[item.token].content = replaceAt(
                tokens2[item.token].content,
                item.pos,
                openQuote
              );
              pos += closeQuote.length - 1;
              if (item.token === i2) {
                pos += openQuote.length - 1;
              }
              text5 = token2.content;
              max9 = text5.length;
              stack.length = j;
              continue OUTER;
            }
          }
        }
        if (canOpen) {
          stack.push({
            token: i2,
            pos: t.index,
            single: isSingle,
            level: thisLevel
          });
        } else if (canClose && isSingle) {
          token2.content = replaceAt(token2.content, t.index, APOSTROPHE);
        }
      }
  }
}
function smartquotes(state4) {
  if (!state4.md.options.typographer) {
    return;
  }
  for (let blkIdx = state4.tokens.length - 1; blkIdx >= 0; blkIdx--) {
    if (state4.tokens[blkIdx].type !== "inline" || !QUOTE_TEST_RE.test(state4.tokens[blkIdx].content)) {
      continue;
    }
    process_inlines(state4.tokens[blkIdx].children, state4);
  }
}

// node_modules/markdown-it/lib/rules_core/text_join.mjs
function text_join(state4) {
  let curr, last4;
  const blockTokens = state4.tokens;
  const l = blockTokens.length;
  for (let j = 0; j < l; j++) {
    if (blockTokens[j].type !== "inline") continue;
    const tokens2 = blockTokens[j].children;
    const max9 = tokens2.length;
    for (curr = 0; curr < max9; curr++) {
      if (tokens2[curr].type === "text_special") {
        tokens2[curr].type = "text";
      }
    }
    for (curr = last4 = 0; curr < max9; curr++) {
      if (tokens2[curr].type === "text" && curr + 1 < max9 && tokens2[curr + 1].type === "text") {
        tokens2[curr + 1].content = tokens2[curr].content + tokens2[curr + 1].content;
      } else {
        if (curr !== last4) {
          tokens2[last4] = tokens2[curr];
        }
        last4++;
      }
    }
    if (curr !== last4) {
      tokens2.length = last4;
    }
  }
}

// node_modules/markdown-it/lib/parser_core.mjs
var _rules = [
  ["normalize", normalize],
  ["block", block],
  ["inline", inline],
  ["linkify", linkify],
  ["replacements", replace],
  ["smartquotes", smartquotes],
  // `text_join` finds `text_special` tokens (for escape sequences)
  // and joins them with the rest of the text
  ["text_join", text_join]
];
function Core() {
  this.ruler = new ruler_default();
  for (let i2 = 0; i2 < _rules.length; i2++) {
    this.ruler.push(_rules[i2][0], _rules[i2][1]);
  }
}
Core.prototype.process = function(state4) {
  const rules = this.ruler.getRules("");
  for (let i2 = 0, l = rules.length; i2 < l; i2++) {
    rules[i2](state4);
  }
};
Core.prototype.State = state_core_default;
var parser_core_default = Core;

// node_modules/markdown-it/lib/rules_block/state_block.mjs
function StateBlock(src, md, env, tokens2) {
  this.src = src;
  this.md = md;
  this.env = env;
  this.tokens = tokens2;
  this.bMarks = [];
  this.eMarks = [];
  this.tShift = [];
  this.sCount = [];
  this.bsCount = [];
  this.blkIndent = 0;
  this.line = 0;
  this.lineMax = 0;
  this.tight = false;
  this.ddIndent = -1;
  this.listIndent = -1;
  this.parentType = "root";
  this.level = 0;
  const s = this.src;
  for (let start3 = 0, pos = 0, indent = 0, offset = 0, len = s.length, indent_found = false; pos < len; pos++) {
    const ch = s.charCodeAt(pos);
    if (!indent_found) {
      if (isSpace(ch)) {
        indent++;
        if (ch === 9) {
          offset += 4 - offset % 4;
        } else {
          offset++;
        }
        continue;
      } else {
        indent_found = true;
      }
    }
    if (ch === 10 || pos === len - 1) {
      if (ch !== 10) {
        pos++;
      }
      this.bMarks.push(start3);
      this.eMarks.push(pos);
      this.tShift.push(indent);
      this.sCount.push(offset);
      this.bsCount.push(0);
      indent_found = false;
      indent = 0;
      offset = 0;
      start3 = pos + 1;
    }
  }
  this.bMarks.push(s.length);
  this.eMarks.push(s.length);
  this.tShift.push(0);
  this.sCount.push(0);
  this.bsCount.push(0);
  this.lineMax = this.bMarks.length - 1;
}
StateBlock.prototype.push = function(type3, tag2, nesting) {
  const token2 = new token_default(type3, tag2, nesting);
  token2.block = true;
  if (nesting < 0) this.level--;
  token2.level = this.level;
  if (nesting > 0) this.level++;
  this.tokens.push(token2);
  return token2;
};
StateBlock.prototype.isEmpty = function isEmpty(line2) {
  return this.bMarks[line2] + this.tShift[line2] >= this.eMarks[line2];
};
StateBlock.prototype.skipEmptyLines = function skipEmptyLines(from2) {
  for (let max9 = this.lineMax; from2 < max9; from2++) {
    if (this.bMarks[from2] + this.tShift[from2] < this.eMarks[from2]) {
      break;
    }
  }
  return from2;
};
StateBlock.prototype.skipSpaces = function skipSpaces(pos) {
  for (let max9 = this.src.length; pos < max9; pos++) {
    const ch = this.src.charCodeAt(pos);
    if (!isSpace(ch)) {
      break;
    }
  }
  return pos;
};
StateBlock.prototype.skipSpacesBack = function skipSpacesBack(pos, min8) {
  if (pos <= min8) {
    return pos;
  }
  while (pos > min8) {
    if (!isSpace(this.src.charCodeAt(--pos))) {
      return pos + 1;
    }
  }
  return pos;
};
StateBlock.prototype.skipChars = function skipChars(pos, code2) {
  for (let max9 = this.src.length; pos < max9; pos++) {
    if (this.src.charCodeAt(pos) !== code2) {
      break;
    }
  }
  return pos;
};
StateBlock.prototype.skipCharsBack = function skipCharsBack(pos, code2, min8) {
  if (pos <= min8) {
    return pos;
  }
  while (pos > min8) {
    if (code2 !== this.src.charCodeAt(--pos)) {
      return pos + 1;
    }
  }
  return pos;
};
StateBlock.prototype.getLines = function getLines(begin, end2, indent, keepLastLF) {
  if (begin >= end2) {
    return "";
  }
  const queue = new Array(end2 - begin);
  for (let i2 = 0, line2 = begin; line2 < end2; line2++, i2++) {
    let lineIndent = 0;
    const lineStart = this.bMarks[line2];
    let first3 = lineStart;
    let last4;
    if (line2 + 1 < end2 || keepLastLF) {
      last4 = this.eMarks[line2] + 1;
    } else {
      last4 = this.eMarks[line2];
    }
    while (first3 < last4 && lineIndent < indent) {
      const ch = this.src.charCodeAt(first3);
      if (isSpace(ch)) {
        if (ch === 9) {
          lineIndent += 4 - (lineIndent + this.bsCount[line2]) % 4;
        } else {
          lineIndent++;
        }
      } else if (first3 - lineStart < this.tShift[line2]) {
        lineIndent++;
      } else {
        break;
      }
      first3++;
    }
    if (lineIndent > indent) {
      queue[i2] = new Array(lineIndent - indent + 1).join(" ") + this.src.slice(first3, last4);
    } else {
      queue[i2] = this.src.slice(first3, last4);
    }
  }
  return queue.join("");
};
StateBlock.prototype.Token = token_default;
var state_block_default = StateBlock;

// node_modules/markdown-it/lib/rules_block/table.mjs
var MAX_AUTOCOMPLETED_CELLS = 65536;
function getLine(state4, line2) {
  const pos = state4.bMarks[line2] + state4.tShift[line2];
  const max9 = state4.eMarks[line2];
  return state4.src.slice(pos, max9);
}
function escapedSplit(str2) {
  const result = [];
  const max9 = str2.length;
  let pos = 0;
  let ch = str2.charCodeAt(pos);
  let isEscaped = false;
  let lastPos = 0;
  let current = "";
  while (pos < max9) {
    if (ch === 124) {
      if (!isEscaped) {
        result.push(current + str2.substring(lastPos, pos));
        current = "";
        lastPos = pos + 1;
      } else {
        current += str2.substring(lastPos, pos - 1);
        lastPos = pos;
      }
    }
    isEscaped = ch === 92;
    pos++;
    ch = str2.charCodeAt(pos);
  }
  result.push(current + str2.substring(lastPos));
  return result;
}
function table(state4, startLine, endLine, silent) {
  if (startLine + 2 > endLine) {
    return false;
  }
  let nextLine = startLine + 1;
  if (state4.sCount[nextLine] < state4.blkIndent) {
    return false;
  }
  if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
    return false;
  }
  let pos = state4.bMarks[nextLine] + state4.tShift[nextLine];
  if (pos >= state4.eMarks[nextLine]) {
    return false;
  }
  const firstCh = state4.src.charCodeAt(pos++);
  if (firstCh !== 124 && firstCh !== 45 && firstCh !== 58) {
    return false;
  }
  if (pos >= state4.eMarks[nextLine]) {
    return false;
  }
  const secondCh = state4.src.charCodeAt(pos++);
  if (secondCh !== 124 && secondCh !== 45 && secondCh !== 58 && !isSpace(secondCh)) {
    return false;
  }
  if (firstCh === 45 && isSpace(secondCh)) {
    return false;
  }
  while (pos < state4.eMarks[nextLine]) {
    const ch = state4.src.charCodeAt(pos);
    if (ch !== 124 && ch !== 45 && ch !== 58 && !isSpace(ch)) {
      return false;
    }
    pos++;
  }
  let lineText = getLine(state4, startLine + 1);
  let columns = lineText.split("|");
  const aligns = [];
  for (let i2 = 0; i2 < columns.length; i2++) {
    const t = columns[i2].trim();
    if (!t) {
      if (i2 === 0 || i2 === columns.length - 1) {
        continue;
      } else {
        return false;
      }
    }
    if (!/^:?-+:?$/.test(t)) {
      return false;
    }
    if (t.charCodeAt(t.length - 1) === 58) {
      aligns.push(t.charCodeAt(0) === 58 ? "center" : "right");
    } else if (t.charCodeAt(0) === 58) {
      aligns.push("left");
    } else {
      aligns.push("");
    }
  }
  lineText = getLine(state4, startLine).trim();
  if (lineText.indexOf("|") === -1) {
    return false;
  }
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  columns = escapedSplit(lineText);
  if (columns.length && columns[0] === "") columns.shift();
  if (columns.length && columns[columns.length - 1] === "") columns.pop();
  const columnCount = columns.length;
  if (columnCount === 0 || columnCount !== aligns.length) {
    return false;
  }
  if (silent) {
    return true;
  }
  const oldParentType = state4.parentType;
  state4.parentType = "table";
  const terminatorRules = state4.md.block.ruler.getRules("blockquote");
  const token_to = state4.push("table_open", "table", 1);
  const tableLines = [startLine, 0];
  token_to.map = tableLines;
  const token_tho = state4.push("thead_open", "thead", 1);
  token_tho.map = [startLine, startLine + 1];
  const token_htro = state4.push("tr_open", "tr", 1);
  token_htro.map = [startLine, startLine + 1];
  for (let i2 = 0; i2 < columns.length; i2++) {
    const token_ho = state4.push("th_open", "th", 1);
    if (aligns[i2]) {
      token_ho.attrs = [["style", "text-align:" + aligns[i2]]];
    }
    const token_il = state4.push("inline", "", 0);
    token_il.content = columns[i2].trim();
    token_il.children = [];
    state4.push("th_close", "th", -1);
  }
  state4.push("tr_close", "tr", -1);
  state4.push("thead_close", "thead", -1);
  let tbodyLines;
  let autocompletedCells = 0;
  for (nextLine = startLine + 2; nextLine < endLine; nextLine++) {
    if (state4.sCount[nextLine] < state4.blkIndent) {
      break;
    }
    let terminate = false;
    for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
      if (terminatorRules[i2](state4, nextLine, endLine, true)) {
        terminate = true;
        break;
      }
    }
    if (terminate) {
      break;
    }
    lineText = getLine(state4, nextLine).trim();
    if (!lineText) {
      break;
    }
    if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
      break;
    }
    columns = escapedSplit(lineText);
    if (columns.length && columns[0] === "") columns.shift();
    if (columns.length && columns[columns.length - 1] === "") columns.pop();
    autocompletedCells += columnCount - columns.length;
    if (autocompletedCells > MAX_AUTOCOMPLETED_CELLS) {
      break;
    }
    if (nextLine === startLine + 2) {
      const token_tbo = state4.push("tbody_open", "tbody", 1);
      token_tbo.map = tbodyLines = [startLine + 2, 0];
    }
    const token_tro = state4.push("tr_open", "tr", 1);
    token_tro.map = [nextLine, nextLine + 1];
    for (let i2 = 0; i2 < columnCount; i2++) {
      const token_tdo = state4.push("td_open", "td", 1);
      if (aligns[i2]) {
        token_tdo.attrs = [["style", "text-align:" + aligns[i2]]];
      }
      const token_il = state4.push("inline", "", 0);
      token_il.content = columns[i2] ? columns[i2].trim() : "";
      token_il.children = [];
      state4.push("td_close", "td", -1);
    }
    state4.push("tr_close", "tr", -1);
  }
  if (tbodyLines) {
    state4.push("tbody_close", "tbody", -1);
    tbodyLines[1] = nextLine;
  }
  state4.push("table_close", "table", -1);
  tableLines[1] = nextLine;
  state4.parentType = oldParentType;
  state4.line = nextLine;
  return true;
}

// node_modules/markdown-it/lib/rules_block/code.mjs
function code(state4, startLine, endLine) {
  if (state4.sCount[startLine] - state4.blkIndent < 4) {
    return false;
  }
  let nextLine = startLine + 1;
  let last4 = nextLine;
  while (nextLine < endLine) {
    if (state4.isEmpty(nextLine)) {
      nextLine++;
      continue;
    }
    if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
      nextLine++;
      last4 = nextLine;
      continue;
    }
    break;
  }
  state4.line = last4;
  const token2 = state4.push("code_block", "code", 0);
  token2.content = state4.getLines(startLine, last4, 4 + state4.blkIndent, false) + "\n";
  token2.map = [startLine, state4.line];
  return true;
}

// node_modules/markdown-it/lib/rules_block/fence.mjs
function fence(state4, startLine, endLine, silent) {
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  let max9 = state4.eMarks[startLine];
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  if (pos + 3 > max9) {
    return false;
  }
  const marker = state4.src.charCodeAt(pos);
  if (marker !== 126 && marker !== 96) {
    return false;
  }
  let mem = pos;
  pos = state4.skipChars(pos, marker);
  let len = pos - mem;
  if (len < 3) {
    return false;
  }
  const markup = state4.src.slice(mem, pos);
  const params = state4.src.slice(pos, max9);
  if (marker === 96) {
    if (params.indexOf(String.fromCharCode(marker)) >= 0) {
      return false;
    }
  }
  if (silent) {
    return true;
  }
  let nextLine = startLine;
  let haveEndMarker = false;
  for (; ; ) {
    nextLine++;
    if (nextLine >= endLine) {
      break;
    }
    pos = mem = state4.bMarks[nextLine] + state4.tShift[nextLine];
    max9 = state4.eMarks[nextLine];
    if (pos < max9 && state4.sCount[nextLine] < state4.blkIndent) {
      break;
    }
    if (state4.src.charCodeAt(pos) !== marker) {
      continue;
    }
    if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
      continue;
    }
    pos = state4.skipChars(pos, marker);
    if (pos - mem < len) {
      continue;
    }
    pos = state4.skipSpaces(pos);
    if (pos < max9) {
      continue;
    }
    haveEndMarker = true;
    break;
  }
  len = state4.sCount[startLine];
  state4.line = nextLine + (haveEndMarker ? 1 : 0);
  const token2 = state4.push("fence", "code", 0);
  token2.info = params;
  token2.content = state4.getLines(startLine + 1, nextLine, len, true);
  token2.markup = markup;
  token2.map = [startLine, state4.line];
  return true;
}

// node_modules/markdown-it/lib/rules_block/blockquote.mjs
function blockquote(state4, startLine, endLine, silent) {
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  let max9 = state4.eMarks[startLine];
  const oldLineMax = state4.lineMax;
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  if (state4.src.charCodeAt(pos) !== 62) {
    return false;
  }
  if (silent) {
    return true;
  }
  const oldBMarks = [];
  const oldBSCount = [];
  const oldSCount = [];
  const oldTShift = [];
  const terminatorRules = state4.md.block.ruler.getRules("blockquote");
  const oldParentType = state4.parentType;
  state4.parentType = "blockquote";
  let lastLineEmpty = false;
  let nextLine;
  for (nextLine = startLine; nextLine < endLine; nextLine++) {
    const isOutdented = state4.sCount[nextLine] < state4.blkIndent;
    pos = state4.bMarks[nextLine] + state4.tShift[nextLine];
    max9 = state4.eMarks[nextLine];
    if (pos >= max9) {
      break;
    }
    if (state4.src.charCodeAt(pos++) === 62 && !isOutdented) {
      let initial = state4.sCount[nextLine] + 1;
      let spaceAfterMarker;
      let adjustTab;
      if (state4.src.charCodeAt(pos) === 32) {
        pos++;
        initial++;
        adjustTab = false;
        spaceAfterMarker = true;
      } else if (state4.src.charCodeAt(pos) === 9) {
        spaceAfterMarker = true;
        if ((state4.bsCount[nextLine] + initial) % 4 === 3) {
          pos++;
          initial++;
          adjustTab = false;
        } else {
          adjustTab = true;
        }
      } else {
        spaceAfterMarker = false;
      }
      let offset = initial;
      oldBMarks.push(state4.bMarks[nextLine]);
      state4.bMarks[nextLine] = pos;
      while (pos < max9) {
        const ch = state4.src.charCodeAt(pos);
        if (isSpace(ch)) {
          if (ch === 9) {
            offset += 4 - (offset + state4.bsCount[nextLine] + (adjustTab ? 1 : 0)) % 4;
          } else {
            offset++;
          }
        } else {
          break;
        }
        pos++;
      }
      lastLineEmpty = pos >= max9;
      oldBSCount.push(state4.bsCount[nextLine]);
      state4.bsCount[nextLine] = state4.sCount[nextLine] + 1 + (spaceAfterMarker ? 1 : 0);
      oldSCount.push(state4.sCount[nextLine]);
      state4.sCount[nextLine] = offset - initial;
      oldTShift.push(state4.tShift[nextLine]);
      state4.tShift[nextLine] = pos - state4.bMarks[nextLine];
      continue;
    }
    if (lastLineEmpty) {
      break;
    }
    let terminate = false;
    for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
      if (terminatorRules[i2](state4, nextLine, endLine, true)) {
        terminate = true;
        break;
      }
    }
    if (terminate) {
      state4.lineMax = nextLine;
      if (state4.blkIndent !== 0) {
        oldBMarks.push(state4.bMarks[nextLine]);
        oldBSCount.push(state4.bsCount[nextLine]);
        oldTShift.push(state4.tShift[nextLine]);
        oldSCount.push(state4.sCount[nextLine]);
        state4.sCount[nextLine] -= state4.blkIndent;
      }
      break;
    }
    oldBMarks.push(state4.bMarks[nextLine]);
    oldBSCount.push(state4.bsCount[nextLine]);
    oldTShift.push(state4.tShift[nextLine]);
    oldSCount.push(state4.sCount[nextLine]);
    state4.sCount[nextLine] = -1;
  }
  const oldIndent = state4.blkIndent;
  state4.blkIndent = 0;
  const token_o = state4.push("blockquote_open", "blockquote", 1);
  token_o.markup = ">";
  const lines = [startLine, 0];
  token_o.map = lines;
  state4.md.block.tokenize(state4, startLine, nextLine);
  const token_c = state4.push("blockquote_close", "blockquote", -1);
  token_c.markup = ">";
  state4.lineMax = oldLineMax;
  state4.parentType = oldParentType;
  lines[1] = state4.line;
  for (let i2 = 0; i2 < oldTShift.length; i2++) {
    state4.bMarks[i2 + startLine] = oldBMarks[i2];
    state4.tShift[i2 + startLine] = oldTShift[i2];
    state4.sCount[i2 + startLine] = oldSCount[i2];
    state4.bsCount[i2 + startLine] = oldBSCount[i2];
  }
  state4.blkIndent = oldIndent;
  return true;
}

// node_modules/markdown-it/lib/rules_block/hr.mjs
function hr(state4, startLine, endLine, silent) {
  const max9 = state4.eMarks[startLine];
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  const marker = state4.src.charCodeAt(pos++);
  if (marker !== 42 && marker !== 45 && marker !== 95) {
    return false;
  }
  let cnt5 = 1;
  while (pos < max9) {
    const ch = state4.src.charCodeAt(pos++);
    if (ch !== marker && !isSpace(ch)) {
      return false;
    }
    if (ch === marker) {
      cnt5++;
    }
  }
  if (cnt5 < 3) {
    return false;
  }
  if (silent) {
    return true;
  }
  state4.line = startLine + 1;
  const token2 = state4.push("hr", "hr", 0);
  token2.map = [startLine, state4.line];
  token2.markup = Array(cnt5 + 1).join(String.fromCharCode(marker));
  return true;
}

// node_modules/markdown-it/lib/rules_block/list.mjs
function skipBulletListMarker(state4, startLine) {
  const max9 = state4.eMarks[startLine];
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  const marker = state4.src.charCodeAt(pos++);
  if (marker !== 42 && marker !== 45 && marker !== 43) {
    return -1;
  }
  if (pos < max9) {
    const ch = state4.src.charCodeAt(pos);
    if (!isSpace(ch)) {
      return -1;
    }
  }
  return pos;
}
function skipOrderedListMarker(state4, startLine) {
  const start3 = state4.bMarks[startLine] + state4.tShift[startLine];
  const max9 = state4.eMarks[startLine];
  let pos = start3;
  if (pos + 1 >= max9) {
    return -1;
  }
  let ch = state4.src.charCodeAt(pos++);
  if (ch < 48 || ch > 57) {
    return -1;
  }
  for (; ; ) {
    if (pos >= max9) {
      return -1;
    }
    ch = state4.src.charCodeAt(pos++);
    if (ch >= 48 && ch <= 57) {
      if (pos - start3 >= 10) {
        return -1;
      }
      continue;
    }
    if (ch === 41 || ch === 46) {
      break;
    }
    return -1;
  }
  if (pos < max9) {
    ch = state4.src.charCodeAt(pos);
    if (!isSpace(ch)) {
      return -1;
    }
  }
  return pos;
}
function markTightParagraphs(state4, idx) {
  const level = state4.level + 2;
  for (let i2 = idx + 2, l = state4.tokens.length - 2; i2 < l; i2++) {
    if (state4.tokens[i2].level === level && state4.tokens[i2].type === "paragraph_open") {
      state4.tokens[i2 + 2].hidden = true;
      state4.tokens[i2].hidden = true;
      i2 += 2;
    }
  }
}
function list(state4, startLine, endLine, silent) {
  let max9, pos, start3, token2;
  let nextLine = startLine;
  let tight = true;
  if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
    return false;
  }
  if (state4.listIndent >= 0 && state4.sCount[nextLine] - state4.listIndent >= 4 && state4.sCount[nextLine] < state4.blkIndent) {
    return false;
  }
  let isTerminatingParagraph = false;
  if (silent && state4.parentType === "paragraph") {
    if (state4.sCount[nextLine] >= state4.blkIndent) {
      isTerminatingParagraph = true;
    }
  }
  let isOrdered;
  let markerValue;
  let posAfterMarker;
  if ((posAfterMarker = skipOrderedListMarker(state4, nextLine)) >= 0) {
    isOrdered = true;
    start3 = state4.bMarks[nextLine] + state4.tShift[nextLine];
    markerValue = Number(state4.src.slice(start3, posAfterMarker - 1));
    if (isTerminatingParagraph && markerValue !== 1) return false;
  } else if ((posAfterMarker = skipBulletListMarker(state4, nextLine)) >= 0) {
    isOrdered = false;
  } else {
    return false;
  }
  if (isTerminatingParagraph) {
    if (state4.skipSpaces(posAfterMarker) >= state4.eMarks[nextLine]) return false;
  }
  if (silent) {
    return true;
  }
  const markerCharCode = state4.src.charCodeAt(posAfterMarker - 1);
  const listTokIdx = state4.tokens.length;
  if (isOrdered) {
    token2 = state4.push("ordered_list_open", "ol", 1);
    if (markerValue !== 1) {
      token2.attrs = [["start", markerValue]];
    }
  } else {
    token2 = state4.push("bullet_list_open", "ul", 1);
  }
  const listLines = [nextLine, 0];
  token2.map = listLines;
  token2.markup = String.fromCharCode(markerCharCode);
  let prevEmptyEnd = false;
  const terminatorRules = state4.md.block.ruler.getRules("list");
  const oldParentType = state4.parentType;
  state4.parentType = "list";
  while (nextLine < endLine) {
    pos = posAfterMarker;
    max9 = state4.eMarks[nextLine];
    const initial = state4.sCount[nextLine] + posAfterMarker - (state4.bMarks[nextLine] + state4.tShift[nextLine]);
    let offset = initial;
    while (pos < max9) {
      const ch = state4.src.charCodeAt(pos);
      if (ch === 9) {
        offset += 4 - (offset + state4.bsCount[nextLine]) % 4;
      } else if (ch === 32) {
        offset++;
      } else {
        break;
      }
      pos++;
    }
    const contentStart = pos;
    let indentAfterMarker;
    if (contentStart >= max9) {
      indentAfterMarker = 1;
    } else {
      indentAfterMarker = offset - initial;
    }
    if (indentAfterMarker > 4) {
      indentAfterMarker = 1;
    }
    const indent = initial + indentAfterMarker;
    token2 = state4.push("list_item_open", "li", 1);
    token2.markup = String.fromCharCode(markerCharCode);
    const itemLines = [nextLine, 0];
    token2.map = itemLines;
    if (isOrdered) {
      token2.info = state4.src.slice(start3, posAfterMarker - 1);
    }
    const oldTight = state4.tight;
    const oldTShift = state4.tShift[nextLine];
    const oldSCount = state4.sCount[nextLine];
    const oldListIndent = state4.listIndent;
    state4.listIndent = state4.blkIndent;
    state4.blkIndent = indent;
    state4.tight = true;
    state4.tShift[nextLine] = contentStart - state4.bMarks[nextLine];
    state4.sCount[nextLine] = offset;
    if (contentStart >= max9 && state4.isEmpty(nextLine + 1)) {
      state4.line = Math.min(state4.line + 2, endLine);
    } else {
      state4.md.block.tokenize(state4, nextLine, endLine, true);
    }
    if (!state4.tight || prevEmptyEnd) {
      tight = false;
    }
    prevEmptyEnd = state4.line - nextLine > 1 && state4.isEmpty(state4.line - 1);
    state4.blkIndent = state4.listIndent;
    state4.listIndent = oldListIndent;
    state4.tShift[nextLine] = oldTShift;
    state4.sCount[nextLine] = oldSCount;
    state4.tight = oldTight;
    token2 = state4.push("list_item_close", "li", -1);
    token2.markup = String.fromCharCode(markerCharCode);
    nextLine = state4.line;
    itemLines[1] = nextLine;
    if (nextLine >= endLine) {
      break;
    }
    if (state4.sCount[nextLine] < state4.blkIndent) {
      break;
    }
    if (state4.sCount[nextLine] - state4.blkIndent >= 4) {
      break;
    }
    let terminate = false;
    for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
      if (terminatorRules[i2](state4, nextLine, endLine, true)) {
        terminate = true;
        break;
      }
    }
    if (terminate) {
      break;
    }
    if (isOrdered) {
      posAfterMarker = skipOrderedListMarker(state4, nextLine);
      if (posAfterMarker < 0) {
        break;
      }
      start3 = state4.bMarks[nextLine] + state4.tShift[nextLine];
    } else {
      posAfterMarker = skipBulletListMarker(state4, nextLine);
      if (posAfterMarker < 0) {
        break;
      }
    }
    if (markerCharCode !== state4.src.charCodeAt(posAfterMarker - 1)) {
      break;
    }
  }
  if (isOrdered) {
    token2 = state4.push("ordered_list_close", "ol", -1);
  } else {
    token2 = state4.push("bullet_list_close", "ul", -1);
  }
  token2.markup = String.fromCharCode(markerCharCode);
  listLines[1] = nextLine;
  state4.line = nextLine;
  state4.parentType = oldParentType;
  if (tight) {
    markTightParagraphs(state4, listTokIdx);
  }
  return true;
}

// node_modules/markdown-it/lib/rules_block/reference.mjs
function reference(state4, startLine, _endLine, silent) {
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  let max9 = state4.eMarks[startLine];
  let nextLine = startLine + 1;
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  if (state4.src.charCodeAt(pos) !== 91) {
    return false;
  }
  function getNextLine(nextLine2) {
    const endLine = state4.lineMax;
    if (nextLine2 >= endLine || state4.isEmpty(nextLine2)) {
      return null;
    }
    let isContinuation = false;
    if (state4.sCount[nextLine2] - state4.blkIndent > 3) {
      isContinuation = true;
    }
    if (state4.sCount[nextLine2] < 0) {
      isContinuation = true;
    }
    if (!isContinuation) {
      const terminatorRules = state4.md.block.ruler.getRules("reference");
      const oldParentType = state4.parentType;
      state4.parentType = "reference";
      let terminate = false;
      for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
        if (terminatorRules[i2](state4, nextLine2, endLine, true)) {
          terminate = true;
          break;
        }
      }
      state4.parentType = oldParentType;
      if (terminate) {
        return null;
      }
    }
    const pos2 = state4.bMarks[nextLine2] + state4.tShift[nextLine2];
    const max10 = state4.eMarks[nextLine2];
    return state4.src.slice(pos2, max10 + 1);
  }
  let str2 = state4.src.slice(pos, max9 + 1);
  max9 = str2.length;
  let labelEnd = -1;
  for (pos = 1; pos < max9; pos++) {
    const ch = str2.charCodeAt(pos);
    if (ch === 91) {
      return false;
    } else if (ch === 93) {
      labelEnd = pos;
      break;
    } else if (ch === 10) {
      const lineContent = getNextLine(nextLine);
      if (lineContent !== null) {
        str2 += lineContent;
        max9 = str2.length;
        nextLine++;
      }
    } else if (ch === 92) {
      pos++;
      if (pos < max9 && str2.charCodeAt(pos) === 10) {
        const lineContent = getNextLine(nextLine);
        if (lineContent !== null) {
          str2 += lineContent;
          max9 = str2.length;
          nextLine++;
        }
      }
    }
  }
  if (labelEnd < 0 || str2.charCodeAt(labelEnd + 1) !== 58) {
    return false;
  }
  for (pos = labelEnd + 2; pos < max9; pos++) {
    const ch = str2.charCodeAt(pos);
    if (ch === 10) {
      const lineContent = getNextLine(nextLine);
      if (lineContent !== null) {
        str2 += lineContent;
        max9 = str2.length;
        nextLine++;
      }
    } else if (isSpace(ch)) {
    } else {
      break;
    }
  }
  const destRes = state4.md.helpers.parseLinkDestination(str2, pos, max9);
  if (!destRes.ok) {
    return false;
  }
  const href = state4.md.normalizeLink(destRes.str);
  if (!state4.md.validateLink(href)) {
    return false;
  }
  pos = destRes.pos;
  const destEndPos = pos;
  const destEndLineNo = nextLine;
  const start3 = pos;
  for (; pos < max9; pos++) {
    const ch = str2.charCodeAt(pos);
    if (ch === 10) {
      const lineContent = getNextLine(nextLine);
      if (lineContent !== null) {
        str2 += lineContent;
        max9 = str2.length;
        nextLine++;
      }
    } else if (isSpace(ch)) {
    } else {
      break;
    }
  }
  let titleRes = state4.md.helpers.parseLinkTitle(str2, pos, max9);
  while (titleRes.can_continue) {
    const lineContent = getNextLine(nextLine);
    if (lineContent === null) break;
    str2 += lineContent;
    pos = max9;
    max9 = str2.length;
    nextLine++;
    titleRes = state4.md.helpers.parseLinkTitle(str2, pos, max9, titleRes);
  }
  let title2;
  if (pos < max9 && start3 !== pos && titleRes.ok) {
    title2 = titleRes.str;
    pos = titleRes.pos;
  } else {
    title2 = "";
    pos = destEndPos;
    nextLine = destEndLineNo;
  }
  while (pos < max9) {
    const ch = str2.charCodeAt(pos);
    if (!isSpace(ch)) {
      break;
    }
    pos++;
  }
  if (pos < max9 && str2.charCodeAt(pos) !== 10) {
    if (title2) {
      title2 = "";
      pos = destEndPos;
      nextLine = destEndLineNo;
      while (pos < max9) {
        const ch = str2.charCodeAt(pos);
        if (!isSpace(ch)) {
          break;
        }
        pos++;
      }
    }
  }
  if (pos < max9 && str2.charCodeAt(pos) !== 10) {
    return false;
  }
  const label = normalizeReference(str2.slice(1, labelEnd));
  if (!label) {
    return false;
  }
  if (silent) {
    return true;
  }
  if (typeof state4.env.references === "undefined") {
    state4.env.references = {};
  }
  if (typeof state4.env.references[label] === "undefined") {
    state4.env.references[label] = { title: title2, href };
  }
  state4.line = nextLine;
  return true;
}

