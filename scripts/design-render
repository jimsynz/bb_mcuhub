// node_modules/dagre-d3-es/src/dagre/layout.js
function layout(g, opts) {
  var time4 = opts && opts.debugTiming ? time2 : notime;
  time4("layout", () => {
    var layoutGraph = time4("  buildLayoutGraph", () => buildLayoutGraph(g));
    time4("  runLayout", () => runLayout(layoutGraph, time4));
    time4("  updateInputGraph", () => updateInputGraph(g, layoutGraph));
  });
}
function runLayout(g, time4) {
  time4("    makeSpaceForEdgeLabels", () => makeSpaceForEdgeLabels(g));
  time4("    removeSelfEdges", () => removeSelfEdges(g));
  time4("    acyclic", () => run(g));
