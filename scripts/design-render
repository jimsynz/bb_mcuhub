  const waveAmplitude = h / 4;
  const finalH = h + waveAmplitude;
  const x3 = -w2 / 2;
  const y3 = -finalH / 2;
  const rectOffset = 5;
  const { cssStyles } = node2;
  const wavePoints = generateFullSineWavePoints(
    x3 - rectOffset,
    y3 + finalH + rectOffset,
    x3 + w2 - rectOffset,
    y3 + finalH + rectOffset,
    waveAmplitude,
    0.8
  );
  const lastWavePoint = wavePoints?.[wavePoints.length - 1];
  const outerPathPoints = [
    { x: x3 - rectOffset, y: y3 + rectOffset },
    { x: x3 - rectOffset, y: y3 + finalH + rectOffset },
    ...wavePoints,
    { x: x3 + w2 - rectOffset, y: lastWavePoint.y - rectOffset },
    { x: x3 + w2, y: lastWavePoint.y - rectOffset },
    { x: x3 + w2, y: lastWavePoint.y - 2 * rectOffset },
    { x: x3 + w2 + rectOffset, y: lastWavePoint.y - 2 * rectOffset },
    { x: x3 + w2 + rectOffset, y: y3 - rectOffset },
    { x: x3 + rectOffset, y: y3 - rectOffset },
    { x: x3 + rectOffset, y: y3 },
    { x: x3, y: y3 },
    { x: x3, y: y3 + rectOffset }
  ];
  const innerPathPoints = [
    { x: x3, y: y3 + rectOffset },
    { x: x3 + w2 - rectOffset, y: y3 + rectOffset },
    { x: x3 + w2 - rectOffset, y: lastWavePoint.y - rectOffset },
    { x: x3 + w2, y: lastWavePoint.y - rectOffset },
