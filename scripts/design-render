function parseStyles(styles4) {
  const stylesObject = {};
  for (const style3 of styles4) {
    const [key2, value] = style3.trim().split(/\s*:\s*/);
    if (key2 === "radius") {
      if (validateNumber(value)) {
        throw new InvalidStyleError(key2, value, "number");
      }
      stylesObject.radius = parseInt(value);
    } else if (key2 === "color") {
      if (validateHexCode(value)) {
        throw new InvalidStyleError(key2, value, "hex code");
      }
      stylesObject.color = value;
    } else if (key2 === "stroke-color") {
      if (validateHexCode(value)) {
        throw new InvalidStyleError(key2, value, "hex code");
      }
      stylesObject.strokeColor = value;
    } else if (key2 === "stroke-width") {
      if (validateSizeInPixels(value)) {
        throw new InvalidStyleError(key2, value, "number of pixels (eg. 10px)");
      }
      stylesObject.strokeWidth = value;
    } else {
      throw new Error(`style named ${key2} is not supported.`);
    }
  }
  return stylesObject;
}
