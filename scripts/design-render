  const useHtmlLabels = evaluate(getConfig2().flowchart?.htmlLabels);
  const w2 = bbox.width + (node2.padding ?? 0);
  const h = w2 + bbox.height;
  const tw = w2 + bbox.height;
  const points = [
    { x: 0, y: 0 },
    { x: tw, y: 0 },
    { x: tw / 2, y: -h }
  ];
