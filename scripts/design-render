        },
        checkPoint: function checkPoint(x3, y3, padding2, width3, height2, centerX, centerY, cornerRadius) {
          var halfWidth = width3 / 2;
          var halfHeight = height2 / 2;
          cornerRadius = cornerRadius === "auto" ? getRoundRectangleRadius(width3, height2) : cornerRadius;
          cornerRadius = Math.min(halfWidth, halfHeight, cornerRadius);
          var diam = cornerRadius * 2;
          if (pointInsidePolygon(x3, y3, this.points, centerX, centerY, width3, height2 - diam, [0, -1], padding2)) {
            return true;
          }
          if (pointInsidePolygon(x3, y3, this.points, centerX, centerY, width3 - diam, height2, [0, -1], padding2)) {
            return true;
          }
          if (checkInEllipse(x3, y3, diam, diam, centerX - halfWidth + cornerRadius, centerY - halfHeight + cornerRadius, padding2)) {
            return true;
          }
          if (checkInEllipse(x3, y3, diam, diam, centerX + halfWidth - cornerRadius, centerY - halfHeight + cornerRadius, padding2)) {
            return true;
          }
          if (checkInEllipse(x3, y3, diam, diam, centerX + halfWidth - cornerRadius, centerY + halfHeight - cornerRadius, padding2)) {
            return true;
          }
          if (checkInEllipse(x3, y3, diam, diam, centerX - halfWidth + cornerRadius, centerY + halfHeight - cornerRadius, padding2)) {
            return true;
          }
          return false;
        }
      };
