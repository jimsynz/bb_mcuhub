  const w2 = Math.max(bbox.width + (node2.padding ?? 0), node2?.width ?? 0);
  const h = Math.max(bbox.height + (node2.padding ?? 0), node2?.height ?? 0);
  const points = [
    { x: -3 * h / 6, y: 0 },
    { x: w2, y: 0 },
    { x: w2 + 3 * h / 6, y: -h },
    { x: 0, y: -h }
  ];
  let polygon2;
  const { cssStyles } = node2;
  if (node2.look === "handDrawn") {
