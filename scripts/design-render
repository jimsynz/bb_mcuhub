  }
});

// node_modules/dagre-d3-es/src/dagre/nesting-graph.js
function run3(g) {
  var root5 = addDummyNode(g, "root", {}, "_root");
  var depths = treeDepths(g);
  var height2 = max_default(values_default(depths)) - 1;
  var nodeSep = 2 * height2 + 1;
  g.graph().nestingRoot = root5;
  forEach_default(g.edges(), function(e) {
    g.edge(e).minlen *= nodeSep;
  });
  var weight8 = sumWeights(g) + 1;
  forEach_default(g.children(), function(child) {
    dfs2(g, root5, nodeSep, weight8, height2, depths, child);
  });
  g.graph().nodeRankFactor = nodeSep;
}
function dfs2(g, root5, nodeSep, weight8, height2, depths, v) {
  var children2 = g.children(v);
  if (!children2.length) {
    if (v !== root5) {
      g.setEdge(root5, v, { weight: 0, minlen: nodeSep });
    }
    return;
  }
  var top2 = addBorderNode(g, "_bt");
  var bottom2 = addBorderNode(g, "_bb");
  var label = g.node(v);
  g.setParent(top2, v);
  label.borderTop = top2;
  g.setParent(bottom2, v);
  label.borderBottom = bottom2;
  forEach_default(children2, function(child) {
    dfs2(g, root5, nodeSep, weight8, height2, depths, child);
    var childNode = g.node(child);
    var childTop = childNode.borderTop ? childNode.borderTop : child;
    var childBottom = childNode.borderBottom ? childNode.borderBottom : child;
    var thisWeight = childNode.borderTop ? weight8 : 2 * weight8;
    var minlen = childTop !== childBottom ? 1 : height2 - depths[v] + 1;
    g.setEdge(top2, childTop, {
      weight: thisWeight,
      minlen,
      nestingEdge: true
    });
    g.setEdge(childBottom, bottom2, {
      weight: thisWeight,
      minlen,
      nestingEdge: true
    });
  });
  if (!g.parent(v)) {
    g.setEdge(root5, top2, { weight: 0, minlen: height2 + depths[v] });
  }
}
function treeDepths(g) {
  var depths = {};
  function dfs3(v, depth) {
    var children2 = g.children(v);
    if (children2 && children2.length) {
      forEach_default(children2, function(child) {
        dfs3(child, depth + 1);
      });
    }
    depths[v] = depth;
  }
  forEach_default(g.children(), function(v) {
    dfs3(v, 1);
  });
  return depths;
}
function sumWeights(g) {
  return reduce_default(
    g.edges(),
    function(acc, e) {
      return acc + g.edge(e).weight;
    },
    0
  );
}
function cleanup(g) {
  var graphLabel = g.graph();
  g.removeNode(graphLabel.nestingRoot);
  delete graphLabel.nestingRoot;
  forEach_default(g.edges(), function(e) {
    var edge = g.edge(e);
    if (edge.nestingEdge) {
      g.removeEdge(e);
    }
  });
}
