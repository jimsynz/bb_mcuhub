    solveCubic = function solveCubic2(a, b, c2, d, result) {
      var epsilon5 = 1e-5;
      if (a === 0) {
        a = epsilon5;
      }
      b /= a;
      c2 /= a;
      d /= a;
      var discriminant, q, r, dum1, s, t, term1, r13;
      q = (3 * c2 - b * b) / 9;
