function escapeHtml2(s) {
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function slugify(s) {
  return String(s).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}
function uniqueSlug(ctx, text5) {
  let slug = slugify(text5) || "section";
  const n = ctx.slugCounts.get(slug) || 0;
  ctx.slugCounts.set(slug, n + 1);
  if (n > 0) slug = `${slug}-${n + 1}`;
  return slug;
}
function stripFrontmatter(src) {
  const lines = src.split("\n");
  const none2 = { body: src, offset: 0, meta: {}, metaLines: {} };
  if (lines[0] !== "---") return none2;
  for (let i2 = 1; i2 < lines.length; i2++) {
    if (/^---\s*$/.test(lines[i2])) {
      const meta3 = {};
      const metaLines = {};
      for (let j = 1; j < i2; j++) {
        const m = lines[j].match(/^([A-Za-z][\w-]*):\s*(.*)$/);
        if (!m) continue;
        meta3[m[1]] = m[2].trim().replace(/^"(.*)"$/s, "$1").replace(/^'(.*)'$/s, "$1");
        metaLines[m[1]] = j;
      }
      return {
        body: lines.slice(i2 + 1).join("\n"),
        offset: i2 + 1,
        meta: meta3,
        metaLines
      };
    }
  }
  return none2;
}
function makeMd(ctx) {
  const md = new lib_default({ html: true, linkify: false });
  for (const kind of KINDS) {
    md.use(container_plugin, kind, {
      validate: (params) => new RegExp(`^${kind}(\\{|\\s|$)`).test(params.trim()),
      render: (tokens2, idx) => tokens2[idx].nesting === 1 ? `<div class="${kind}">
` : "</div>\n"
    });
  }
  const defaultFence = md.renderer.rules.fence;
  md.renderer.rules.fence = (tokens2, idx, options3, env, self2) => {
    const token2 = tokens2[idx];
    const lang = (token2.info || "").trim().split(/\s+/)[0];
    if (lang === "mermaid") {
      ctx.usedMermaid = true;
      ctx.used.diagram = true;
      return `<div class="diagram"><pre class="mermaid">${escapeHtml2(token2.content)}</pre></div>
`;
    }
    if (lang === "vega-lite") {
      ctx.used.diagram = true;
      ctx.vegaCount += 1;
      const id27 = `vega-vis-${ctx.vegaCount}`;
      ctx.vegaSpecs.push({ id: id27, spec: JSON.parse(token2.content) });
      return `<div class="diagram"><div class="vega" id="${id27}"></div></div>
`;
    }
    return defaultFence(tokens2, idx, options3, env, self2);
  };
  md.renderer.rules.heading_open = (tokens2, idx, options3, env, self2) => {
    const inline3 = tokens2[idx + 1];
    if (inline3 && inline3.type === "inline") {
      tokens2[idx].attrSet("id", uniqueSlug(ctx, inline3.content));
    }
    return self2.renderToken(tokens2, idx, options3);
  };
  const defaultCodeInline = md.renderer.rules.code_inline;
  md.renderer.rules.code_inline = (tokens2, idx, options3, env, self2) => {
    const m = tokens2[idx].content.match(/^lens:(.+)$/s);
    if (!m) return defaultCodeInline(tokens2, idx, options3, env, self2);
    return lensPillHtml(m[1]);
  };
  const defaultLinkOpen = md.renderer.rules.link_open || ((tokens2, idx, options3, env, self2) => self2.renderToken(tokens2, idx, options3));
  md.renderer.rules.link_open = (tokens2, idx, options3, env, self2) => {
    const href = tokens2[idx].attrGet("href");
    if (href) {
      const rewritten = rewriteDesignLink(href);
      if (rewritten !== href) tokens2[idx].attrSet("href", rewritten);
    }
    return defaultLinkOpen(tokens2, idx, options3, env, self2);
  };
  return md;
}
function rewriteDesignLink(href) {
  const hash = href.indexOf("#");
  const pathPart = hash === -1 ? href : href.slice(0, hash);
  const fragment = hash === -1 ? "" : href.slice(hash);
  if (pathPart === "" || /^[a-z][a-z0-9+.-]*:/i.test(pathPart)) return href;
  const slash = pathPart.lastIndexOf("/");
  const base = slash === -1 ? pathPart : pathPart.slice(slash + 1);
  if (base !== "design.md") return href;
  return pathPart.slice(0, pathPart.length - "design.md".length) + "design.html" + fragment;
}
function segment(tokens2, ctx) {
  const nodes6 = [];
  let run5 = [];
  const flush = () => {
    if (run5.length) nodes6.push({ type: "run", tokens: run5 });
    run5 = [];
  };
  for (let i2 = 0; i2 < tokens2.length; i2++) {
    const t = tokens2[i2];
    const containerOpen = t.type.match(/^container_(.+)_open$/);
    if (t.type === "heading_open" && t.tag === "h2" && t.level === 0) {
      flush();
      const inline3 = tokens2[i2 + 1];
      nodes6.push({
        type: "h2",
        text: inline3 && inline3.type === "inline" ? inline3.content : "",
        line: t.map ? t.map[0] : 0
      });
      i2 += 2;
      continue;
    }
    if (containerOpen && t.level === 0) {
      flush();
      const kind = containerOpen[1];
      const closeType = `container_${kind}_close`;
      let j = i2 + 1;
      while (j < tokens2.length && !(tokens2[j].type === closeType && tokens2[j].level === 0))
        j++;
      nodes6.push({
        type: "directive",
        kind,
        params: t.info || "",
        inner: tokens2.slice(i2 + 1, j),
        line: t.map ? t.map[0] : 0,
        endLine: t.map ? t.map[1] : 0
      });
      i2 = j;
      continue;
    }
    run5.push(t);
  }
  flush();
  return nodes6;
}
function splitCardItems(inner2) {
  const bounds4 = [];
  for (let i2 = 0; i2 < inner2.length; i2++) {
    const t = inner2[i2];
    if (t.type === "heading_open" && t.tag === "h3" && t.level === 1) {
      bounds4.push(i2);
    }
  }
  if (bounds4.length === 0) return { error: "no-items" };
  if (bounds4[0] !== 0) return { error: "leading-body" };
  return {
    items: bounds4.map((b, i2) => inner2.slice(b, bounds4[i2 + 1] ?? inner2.length))
  };
}
function parseStatementFields(inner2) {
  if (inner2.length < 3 || inner2[0].type !== "paragraph_open" || inner2[1].type !== "inline" || !inner2[1].children) {
    return { error: "no-label" };
  }
  const children2 = inner2[1].children;
  const brk = children2.findIndex(
    (c2) => c2.type === "softbreak" || c2.type === "hardbreak"
  );
  let firstLine = brk === -1 ? children2 : children2.slice(0, brk);
  const blank = (c2) => c2.type === "text" && c2.content.trim() === "";
  while (firstLine.length && blank(firstLine[0])) {
    firstLine = firstLine.slice(1);
  }
  while (firstLine.length && blank(firstLine[firstLine.length - 1])) {
    firstLine = firstLine.slice(0, -1);
  }
  if (firstLine.length < 2 || firstLine[0].type !== "strong_open" || firstLine[firstLine.length - 1].type !== "strong_close") {
    return { error: "no-label" };
  }
  const labelTokens = firstLine.slice(1, -1);
  if (labelTokens.some((c2) => c2.type === "link_open")) {
    return { error: "link-in-label" };
  }
  if (labelTokens.some((c2) => c2.type !== "text")) {
    return { error: "not-plain" };
  }
  const labelText = labelTokens.map((c2) => c2.content).join("");
  if (labelText.length > 64) return { error: "too-long", labelText };
  const restChildren = brk === -1 ? [] : children2.slice(brk + 1);
  const hasParaRest = restChildren.some(
    (c2) => c2.type === "text" ? c2.content.trim() !== "" : c2.type !== "softbreak" && c2.type !== "hardbreak"
  );
  const afterTokens = inner2.slice(3);
  return {
    labelText,
    restChildren: hasParaRest ? restChildren : [],
    afterTokens,
    hasBody: hasParaRest || afterTokens.length > 0
  };
}
function renderCardItem(ctx, md, slice4) {
  const inline3 = slice4[1];
  const children2 = inline3 && inline3.children || [];
  let end2 = children2.length;
  while (end2 > 0 && children2[end2 - 1].type === "text" && children2[end2 - 1].content.trim() === "") {
    end2--;
  }
  let split = end2;
  const last4 = children2[end2 - 1];
  if (last4 && last4.type === "code_inline" && /^lens:/.test(last4.content)) {
    split = end2 - 1;
  } else if (last4 && last4.type === "link_close") {
    for (let i2 = end2 - 2; i2 >= 0; i2--) {
      if (children2[i2].type === "link_open") {
        split = i2;
        break;
      }
    }
  }
  let labelEnd = split;
  while (labelEnd > 0 && children2[labelEnd - 1].type === "text" && children2[labelEnd - 1].content.trim() === "") {
    labelEnd--;
  }
  const label = md.renderer.renderInline(
    children2.slice(0, labelEnd),
    md.options,
    {}
  );
  const badges = split < end2 ? md.renderer.renderInline(children2.slice(split, end2), md.options, {}) : "";
  const id27 = uniqueSlug(ctx, inline3 ? inline3.content : "card");
  const bodyTokens = slice4.slice(3);
  const body = bodyTokens.length ? md.renderer.render(bodyTokens, md.options, {}) : "";
  return `<article class="card" id="${id27}">
<div class="entry-head"><span class="label">${label}</span>` + (badges ? `<span class="badges">${badges}</span>` : "") + `</div>
` + (body ? `<div class="body">
${body}</div>
` : "") + `</article>`;
}
function lensPillHtml(value) {
  const names = [...new Set(value.split("+").map((s) => s.trim()))].sort(
    (a, b) => LENSES.indexOf(a) - LENSES.indexOf(b)
  );
  if (names.length === 1) {
    return `<span class="pill ${names[0]}">${names[0]}</span>`;
  }
  const stops = names.map((l) => `var(--lens-${l}-bg)`).join(", ");
  return `<span class="pill combo" style="--pill-stops: ${stops}">${names.join(" + ")}</span>`;
}
function checkLensSpan(content, pushViolation, used) {
  const m = content.match(/^lens:(.*)$/s);
  if (!m) return;
  const seen = /* @__PURE__ */ new Set();
  for (const name of m[1].split("+").map((s) => s.trim())) {
    if (!LENSES.includes(name)) {
      pushViolation(
        `unknown lens '${name}' in \`lens:\` span`,
        `lenses (fixed order): ${LENSES.join(", ")}`
      );
    } else if (seen.has(name)) {
      pushViolation(
        `duplicate lens '${name}' in \`lens:\` combo`,
        "each lens appears at most once in a combo pill"
      );
    } else {
      seen.add(name);
      used.lenses.add(name);
    }
  }
  if (seen.size >= 2) used.combo = true;
}
function parseParams(kind, params) {
  const rest = params.trim().slice(kind.length).trim();
  if (rest === "") return { attrs: {} };
  const m = rest.match(/^\{(.*)\}$/s);
  if (!m) return { error: `malformed directive params '${params.trim()}'` };
  const attrs = {};
  let s = m[1].trim();
  const pair = /^([A-Za-z][\w-]*)=(?:"([^"]*)"|([^\s"]+))(?:\s+|$)/;
  while (s.length) {
    const mm = s.match(pair);
    if (!mm)
      return { error: `unparseable attributes near '${s.slice(0, 24)}'` };
    const key2 = mm[1];
    const val = mm[2] !== void 0 ? mm[2] : mm[3];
    if (key2 in attrs) return { error: `duplicate attribute '${key2}'` };
    attrs[key2] = val;
    s = s.slice(mm[0].length);
  }
  return { attrs };
}
function hasAdrLink(innerTokens) {
  for (const t of innerTokens) {
    if (t.type !== "inline" || !t.children) continue;
    for (const c2 of t.children) {
      if (c2.type !== "link_open") continue;
      const href = c2.attrGet("href") || "";
      const hash = href.indexOf("#");
      if (hash >= 0 && ADR_ID_RE.test(href.slice(hash + 1))) return true;
    }
  }
  return false;
}
function linksChildContext(ctx) {
  const re2 = /\]\(\s*<?([^)\s>]+)/g;
  const body = ctx.bodyLines.join("\n");
  let m;
  while ((m = re2.exec(body)) !== null) {
    const pathPart = m[1].split("#")[0];
    if (!pathPart.endsWith("design.md")) continue;
    if (pathPart.startsWith("/") || pathPart.startsWith("..")) continue;
    const dir2 = pathPart.slice(0, -"design.md".length).replace(/\/$/, "");
    if (dir2 !== "" && !dir2.includes("..")) return true;
  }
  return false;
}
async function validate(ctx, md, nodes6, allTokens) {
  const v = (line2, what, why) => ctx.violations.push({ line: line2 + 1 + ctx.fmOffset, what, why });
  for (const key2 of ["eyebrow", "lede", "footer"]) {
    const val = ctx.meta[key2];
    if (val === void 0) continue;
    const inline3 = md.parseInline(val, {})[0];
    for (const c2 of inline3?.children || []) {
      if (c2.type !== "code_inline") continue;
      checkLensSpan(
        c2.content,
        (what, why) => ctx.violations.push({
          line: (ctx.metaLines[key2] ?? 0) + 1,
          what,
          why
        }),
        ctx.used
      );
    }
  }
  for (const t of allTokens) {
    const open2 = t.type.match(/^container_(.+)_open$/);
    if (open2 && t.level > 0) {
      v(
        t.map ? t.map[0] : 0,
        `nested directive :::${open2[1]}`,
        "directives must be top-level blocks, never nested"
      );
    }
    if (t.type === "inline" && typeof t.content === "string") {
      const lines = t.content.split("\n");
      for (let li = 0; li < lines.length; li++) {
        const line2 = lines[li].trim();
        const dm = line2.match(/^(:{3,})\s*(\S.*)?$/);
        if (!dm) continue;
        const at = (t.map ? t.map[0] : 0) + li;
        if (dm[2]) {
          v(
            at,
            `unknown or malformed directive '${line2.slice(0, 40)}'`,
            `known kinds: ${KINDS.join(", ")} \u2014 with well-formed {key=value} attrs`
          );
        } else {
          v(
            at,
            "stray directive close marker ':::'",
            "a ':::' closer must terminate an opened directive block"
          );
        }
      }
    }
    if (t.type === "inline" && t.children) {
      for (const c2 of t.children) {
        if (c2.type !== "code_inline") continue;
        checkLensSpan(
          c2.content,
          (what, why) => v(t.map ? t.map[0] : 0, what, why),
          ctx.used
        );
      }
    }
  }
  const mermaidFences = [];
  const walkFences = (tokens2) => {
    for (const t of tokens2) {
      if (t.type !== "fence") continue;
      const lang = (t.info || "").trim().split(/\s+/)[0];
      if (lang === "vega-lite") {
        try {
          JSON.parse(t.content);
        } catch (e) {
          v(
            t.map ? t.map[0] : 0,
            "invalid vega-lite spec",
            `body must be valid JSON: ${e.message}`
          );
        }
      } else if (lang === "mermaid") {
        mermaidFences.push(t);
      }
    }
  };
  walkFences(allTokens);
  if (mermaidFences.length) {
    const parse11 = await getMermaidParse();
    for (const t of mermaidFences) {
      try {
        await parse11(t.content);
      } catch (e) {
        const first3 = String(e && e.message ? e.message : e).split("\n")[0].trim();
        v(t.map ? t.map[0] : 0, "mermaid syntax error", first3);
      }
    }
  }
  const h2s = nodes6.filter((n) => n.type === "h2");
  const sections6 = [];
  for (const h of h2s) {
    const sec = parseSectionHeading(h.text);
    if (sec && sec !== "pending") {
      sections6.push({
        num: sec.num,
        raw: sec.raw,
        title: sec.title,
        line: h.line
      });
    } else if (sec === "pending") {
      sections6.push({ num: "pending", line: h.line });
    } else {
      v(
        h.line,
        `unrecognized section heading '## ${h.text}'`,
        "sections are numbered 'NN Title' (zero-padded, dense from 00) or the unnumbered 'Pending updates'"
      );
    }
  }
  const numbered = sections6.filter((s) => typeof s.num === "number");
  const pendingHeads = sections6.filter((s) => s.num === "pending");
  if (numbered.length === 0) {
    v(
      0,
      "missing section '## 00 Foundation'",
      "the spine starts at a zero-padded section 00 whose title contains 'Foundation'"
    );
  } else {
    numbered.forEach((s, i2) => {
      if (s.num !== i2) {
        v(
          s.line,
          `section number ${s.raw} out of sequence (expected ${String(i2).padStart(2, "0")})`,
          "numbered sections are dense ascending from 00"
        );
      }
    });
    if (numbered[0].num === 0 && !/Foundation/.test(numbered[0].title)) {
      v(
        numbered[0].line,
        `section 00 titled '${numbered[0].title}'`,
        "section 00's title must contain 'Foundation'"
      );
    }
  }
  if (pendingHeads.length > 1) {
    v(
      pendingHeads[1].line,
      "duplicate '## Pending updates' section",
      "the pending ledger has exactly one home"
    );
  }
  if (pendingHeads.length === 1) {
    const idx = sections6.indexOf(pendingHeads[0]);
    const prev2 = sections6[idx - 1];
    if (!prev2 || prev2.num !== 0) {
      v(
        pendingHeads[0].line,
        "'## Pending updates' out of place",
        "the pending ledger sits between section 00 and section 01"
      );
    }
  }
  let cur = null;
  let foundationRank = -1;
  let prevFoundationKind = null;
  const foundationCounts = {
    goal: 0,
    "no-goal": 0,
    invariant: 0,
    principle: 0
  };
  let pendingCount = 0;
  for (const n of nodes6) {
    if (n.type === "h2") {
      const sec = parseSectionHeading(n.text);
      cur = sec === "pending" ? "pending" : sec ? sec.num : cur;
      continue;
    }
    if (n.type !== "directive") continue;
    const lastLine = ctx.bodyLines[n.endLine];
    if (lastLine === void 0 || !/^\s*:{3,}\s*$/.test(lastLine)) {
      v(
        n.line,
        `unclosed directive :::${n.kind}`,
        "every directive block ends with a ':::' closer"
      );
    }
    if (FOUNDATION_ORDER.includes(n.kind)) {
      if (cur !== 0) {
        v(
          n.line,
          `:::${n.kind} outside section 00`,
          "foundation kinds live in section 00 (Foundation)"
        );
      } else {
        const rank2 = FOUNDATION_ORDER.indexOf(n.kind);
        if (rank2 < foundationRank) {
          v(
            n.line,
            `foundation kind :::${n.kind} appears after :::${prevFoundationKind}`,
            `section 00 orders its kinds: ${FOUNDATION_ORDER.map((k) => `:::${k}`).join(" \u2192 ")}`
          );
        }
        if (rank2 >= foundationRank) {
          foundationRank = rank2;
          prevFoundationKind = n.kind;
        }
        foundationCounts[n.kind] += 1;
      }
    }
    if (n.kind === "pending") {
      if (cur !== "pending") {
        v(
          n.line,
          ":::pending outside the 'Pending updates' section",
          "pending entries live only in the unnumbered '## Pending updates' section after section 00"
        );
      } else {
        pendingCount += 1;
      }
    }
    const parsed = parseParams(n.kind, n.params);
    if (parsed.error) {
      v(
        n.line,
        `:::${n.kind} \u2014 ${parsed.error}`,
        "attrs are a single {key=value key2=value2} group"
      );
      continue;
    }
    const attrs = parsed.attrs;
    n.attrs = attrs;
    for (const key2 of Object.keys(attrs)) {
      if (!ALLOWED_ATTRS[n.kind].includes(key2)) {
        v(
          n.line,
          `:::${n.kind} \u2014 unknown attribute '${key2}'`,
          ALLOWED_ATTRS[n.kind].length ? `allowed: ${ALLOWED_ATTRS[n.kind].join(", ")}` : `:::${n.kind} takes no attributes`
        );
      }
    }
    const has4 = (key2) => attrs[key2] !== void 0 && ALLOWED_ATTRS[n.kind].includes(key2);
    if (has4("tint")) {
      if (!TINTS.includes(attrs.tint)) {
        v(
          n.line,
          `:::${n.kind} \u2014 tint '${attrs.tint}'`,
          `tint is one of: ${TINTS.join(", ")}`
        );
      } else {
        ctx.used.tints.add(attrs.tint);
      }
    }
    if (has4("lens")) {
      checkLensSpan(
        `lens:${attrs.lens}`,
        (what, why) => v(n.line, `:::${n.kind} \u2014 ${what}`, why),
        ctx.used
      );
    }
    if (has4("id")) {
      if (!ID_RE.test(attrs.id)) {
        v(
          n.line,
          `:::${n.kind} \u2014 id '${attrs.id}'`,
          "id must match ^[A-Za-z][A-Za-z0-9-]*$"
        );
      } else if (ctx.entryIds.has(attrs.id)) {
        v(
          n.line,
          `:::${n.kind} \u2014 duplicate id '${attrs.id}'`,
          "entry ids are unique anchors across the document"
        );
      } else {
        ctx.entryIds.add(attrs.id);
        ctx.used.entryId = true;
      }
    }
    if (FOUNDATION_ORDER.includes(n.kind)) {
      const f = parseStatementFields(n.inner);
      if (f.error === "no-label") {
        v(
          n.line,
          `:::${n.kind} \u2014 missing label`,
          "the block's first line must be a bold label (**\u2026**) alone \u2014 the short description a reader scans"
        );
      } else if (f.error === "link-in-label") {
        v(
          n.line,
          `:::${n.kind} \u2014 label contains a link`,
          "the label is plain text (\u226464 chars); links belong in the body"
        );
      } else if (f.error === "not-plain") {
        v(
          n.line,
          `:::${n.kind} \u2014 label is not plain text`,
          "the label is plain bold text \u2014 no links, code, or nested markup"
        );
      } else if (f.error === "too-long") {
        v(
          n.line,
          `:::${n.kind} \u2014 label is ${f.labelText.length} characters (max 64)`,
          "the label is the short description; move detail into the body"
        );
      } else {
        n.fields = f;
        if (!f.hasBody && n.kind !== "no-goal") {
          v(
            n.line,
            `:::${n.kind} \u2014 empty body`,
            "goal, principle, and invariant require a body (for an invariant, the checkable statement); only no-goal may omit it"
          );
        }
      }
    }
    if (n.kind === "cards") {
      if (has4("cols") && !CARD_COLS.includes(attrs.cols)) {
        v(
          n.line,
          `:::cards \u2014 cols '${attrs.cols}'`,
          `cols is one of: ${CARD_COLS.join(", ")} (omit for auto-fit)`
        );
      }
      if (has4("size") && !CARD_SIZES.includes(attrs.size)) {
        v(
          n.line,
          `:::cards \u2014 size '${attrs.size}'`,
          `size is one of: ${CARD_SIZES.join(", ")}`
        );
      }
      const split = splitCardItems(n.inner);
      if (split.error === "no-items") {
        v(
          n.line,
          ":::cards \u2014 no '###' items",
          "a cards grid holds at least one item, each opened by a '###' heading"
        );
      } else if (split.error === "leading-body") {
        v(
          n.line,
          ":::cards \u2014 body before the first '###' item",
          "all cards content lives under '###' item headings"
        );
      }
    }
    if (n.kind === "invariant") {
      if (attrs.script) ctx.used.script = true;
      const e = attrs.enforcement;
      if (!e || !ENFORCEMENT.includes(e)) {
        v(
          n.line,
          `:::invariant \u2014 enforcement '${e ?? "(missing)"}'`,
          `enforcement is required and one of: ${ENFORCEMENT.join(", ")}`
        );
      } else if ((e === "mechanism" || e === "partial") && !attrs.script) {
        v(
          n.line,
          `:::invariant \u2014 enforcement=${e} without script`,
          e === "mechanism" ? "a mechanism invariant names the script that decides it (script=<name>)" : "a partial invariant names the script that checks its mechanical shadow (script=<name>)"
        );
      }
    }
    if (n.kind === "pending") {
      if (!attrs.kind || !PENDING_KINDS.includes(attrs.kind)) {
        v(
          n.line,
          `:::pending \u2014 kind '${attrs.kind ?? "(missing)"}'`,
          `kind is required and one of: ${PENDING_KINDS.join(", ")}`
        );
      }
      if (!attrs.since || !/^\d{4}-\d{2}-\d{2}$/.test(attrs.since)) {
        v(
          n.line,
          `:::pending \u2014 since '${attrs.since ?? "(missing)"}'`,
          "since is required as YYYY-MM-DD (lets review report aging entries as design debt)"
        );
      }
      if (attrs.kind === "build" && !hasAdrLink(n.inner)) {
        v(
          n.line,
          ":::pending \u2014 build entry must link its ADR (#adr-NNNN fragment)",
          "a build entry cites the decision it builds; a link without an adr-NNNN fragment (e.g. a self-link) is not sufficient"
        );
      }
    }
    if (n.kind === "svg") {
      if (!attrs.file) {
        v(
          n.line,
          ":::svg \u2014 missing 'file' attribute",
          "svg embeds a sibling file: :::svg{file=name.svg}"
        );
      } else {
        const p2 = import_node_path.default.resolve(ctx.mdDir, attrs.file);
        let content = null;
        try {
          content = import_node_fs.default.readFileSync(p2, "utf8");
        } catch {
          v(
            n.line,
            `:::svg \u2014 file not found: '${attrs.file}'`,
            `no readable file at ${p2} (relative to the design.md)`
          );
        }
        if (content !== null) {
          if (!/<svg[\s>]/i.test(content)) {
            v(
              n.line,
              `:::svg \u2014 '${attrs.file}' is not an SVG`,
              "the file must contain an <svg> element to embed inline"
            );
          } else {
            n.svgContent = content;
          }
        }
      }
    }
  }
  if (numbered.length > 0 && numbered[0].num === 0) {
    const indexOnly = ctx.meta.index_only === "true";
    if (indexOnly && !linksChildContext(ctx)) {
      v(
        numbered[0].line,
        "index_only set on a document with no child contexts",
        "index_only: true is legal only on a root that links at least one child <context>/design.md; a single-domain document carries its own foundation"
      );
    }
    if (!indexOnly) {
      for (const kind of ["goal", "invariant", "principle"]) {
        if (foundationCounts[kind] === 0) {
          v(
            numbered[0].line,
            `section 00 has no :::${kind}`,
            "the foundation requires at least one goal, one invariant, and one principle (or index_only: true on a multi-context root)"
          );
        }
      }
    }
  }
  if (pendingHeads.length === 1 && pendingCount === 0) {
    v(
      pendingHeads[0].line,
      "empty 'Pending updates' section",
      "an empty pending ledger is omitted entirely (its absence states 'this page is the present')"
    );
  }
}
function parseSectionHeading(text5) {
  const t = text5.trim();
  if (t === "Pending updates") return "pending";
  const m = t.match(/^(\d{2})(?:$|\s+(?:·\s*)?)(.*)$/);
  if (!m) return null;
  return { num: parseInt(m[1], 10), raw: m[1], title: m[2] };
}
var FOUNDATION_LABELS = {
  goal: "Goals",
  "no-goal": "No-goals",
  invariant: "Invariants",
  principle: "Principles"
};
function renderNodes(ctx, md, nodes6) {
  const out = [];
  let foundationSlot = -1;
  const foundationBuf = {
    goal: [],
    "no-goal": [],
    invariant: [],
    principle: []
  };
  let pendingSlot = -1;
  const pendingBuf = [];
  const flushFoundation = () => {
    if (foundationSlot === -1) return;
    const cards = FOUNDATION_ORDER.filter((k) => foundationBuf[k].length).map(
      (k) => `<div class="kind ${k}">
<h3>${FOUNDATION_LABELS[k]}</h3>
${foundationBuf[k].join("")}</div>`
    );
    out[foundationSlot] = `<div class="foundation">
${cards.join("\n")}
</div>
`;
    for (const k of FOUNDATION_ORDER) foundationBuf[k] = [];
    foundationSlot = -1;
  };
  const flushPending = () => {
    if (pendingSlot === -1) return;
    out[pendingSlot] = `<div class="pending">
${pendingBuf.join("")}</div>
`;
    pendingBuf.length = 0;
    pendingSlot = -1;
  };
  const renderInner = (inner2) => md.renderer.render(inner2, md.options, {});
  for (const n of nodes6) {
    if (n.type === "h2") {
      flushFoundation();
      flushPending();
      const id27 = uniqueSlug(ctx, n.text);
      const sec = parseSectionHeading(n.text);
      if (sec && sec !== "pending") {
        out.push(
          `<h2 id="${id27}"><span class="secno">${sec.raw}</span> \xB7 ${md.renderInline(sec.title)}</h2>
`
        );
      } else {
        out.push(`<h2 id="${id27}">${md.renderInline(n.text)}</h2>
`);
      }
      continue;
    }
    if (n.type === "run") {
      out.push(md.renderer.render(n.tokens, md.options, {}));
      continue;
    }
    const attrs = n.attrs || {};
    if (FOUNDATION_ORDER.includes(n.kind)) {
      if (foundationSlot === -1) {
        foundationSlot = out.length;
        out.push("");
      }
      ctx.used.foundation.add(n.kind);
      const badges = [];
      if (attrs.id) {
        badges.push(`<span class="entry-id">${escapeHtml2(attrs.id)}</span>`);
      }
      if (n.kind === "invariant") {
        ctx.used.enf.add(attrs.enforcement);
        badges.push(
          `<span class="enf ${attrs.enforcement}">${attrs.enforcement}</span>`
        );
        if (attrs.script) {
          badges.push(
            `<span class="script-chip">${escapeHtml2(attrs.script)}</span>`
          );
        }
      }
      if (attrs.lens) {
        badges.push(lensPillHtml(attrs.lens));
      }
      const f = n.fields;
      const head2 = `<div class="entry-head"><span class="label">${escapeHtml2(f.labelText)}</span>` + (badges.length ? `<span class="badges">${badges.join(" ")}</span>` : "") + `</div>
`;
      const paraRest = f.restChildren.length ? `<p>${md.renderer.renderInline(f.restChildren, md.options, {})}</p>
` : "";
      const after2 = f.afterTokens.length ? md.renderer.render(f.afterTokens, md.options, {}) : "";
      const bodyHtml = paraRest + after2;
      const anchor2 = attrs.id ? ` id="${escapeHtml2(attrs.id)}"` : "";
      foundationBuf[n.kind].push(
        `<div class="entry ${n.kind}"${anchor2}>
${head2}` + (bodyHtml ? `<div class="body">
${bodyHtml}</div>
` : "") + `</div>
`
      );
    } else if (n.kind === "pending") {
      if (pendingSlot === -1) {
        pendingSlot = out.length;
        out.push("");
      }
      ctx.used.badges.add(attrs.kind);
      pendingBuf.push(
        `<div class="entry"><div class="entry-head"><span class="badges"><span class="badge ${attrs.kind}">${attrs.kind}</span> <span class="since">since ${attrs.since}</span></span></div>
<div class="body">
${renderInner(n.inner)}</div>
</div>
`
      );
    } else if (n.kind === "info" || n.kind === "warning") {
      ctx.used.callouts.add(n.kind);
      const tint = attrs.tint ? ` tint-${attrs.tint}` : "";
      const head2 = attrs.title ? `<div class="entry-head"><span class="label">${md.renderInline(attrs.title)}</span></div>
` : "";
      out.push(
        `<div class="callout ${n.kind}${tint}">
${head2}<div class="body">
${renderInner(n.inner)}</div>
</div>
`
      );
    } else if (n.kind === "cards") {
      const cls = ["cards"];
      if (attrs.cols) cls.push(`cols-${attrs.cols}`);
      if (attrs.size === "sm") cls.push("size-sm");
      if (attrs.tint) cls.push(`tint-${attrs.tint}`);
      const { items } = splitCardItems(n.inner);
      const cells = (items || []).map((slice4) => renderCardItem(ctx, md, slice4)).join("\n");
      out.push(`<div class="${cls.join(" ")}">
${cells}
</div>
`);
    } else if (n.kind === "svg") {
      ctx.used.diagram = true;
      out.push(
        `<div class="diagram">
${(n.svgContent || "").trim()}
</div>
`
      );
    }
  }
  flushFoundation();
  flushPending();
  return out.join("");
}
function buildLegend(ctx) {
  const rows = [];
  if (ctx.used.foundation.size) {
    rows.push([
      "Foundation",
      FOUNDATION_ORDER.filter((k) => ctx.used.foundation.has(k)).map(
        (k) => `<span class="label kind-${k}">${FOUNDATION_LABELS[k]}</span>`
      ).join(" ")
    ]);
  }
  const lenses = LENSES.filter((l) => ctx.used.lenses.has(l));
  if (lenses.length) {
    rows.push([
      "Lenses",
      lenses.map((l) => `<span class="pill ${l}">${l}</span>`).join(" ") + " <span>judgment axes</span>"
    ]);
  }
  if (ctx.used.combo) {
    rows.push([
      "Combo",
      `<span class="pill combo">blended lenses</span> <span>fixed order</span>`
    ]);
  }
  const enf = ENFORCEMENT.filter((e) => ctx.used.enf.has(e));
  if (enf.length) {
    rows.push([
      "Enforcement",
      enf.map((e) => `<span class="enf ${e}">${e}</span>`).join(" ") + " <span>strong \u2192 weak</span>"
    ]);
  }
  if (ctx.used.script || ctx.used.entryId) {
    const chips = [];
    if (ctx.used.script)
      chips.push(`<span class="script-chip">deciding-script</span>`);
    if (ctx.used.entryId) chips.push(`<span class="entry-id">P1</span>`);
    rows.push([
      "Chips",
      chips.join(" ") + " <span>script that decides \xB7 citable id</span>"
    ]);
  }
  const badges = PENDING_KINDS.filter((k) => ctx.used.badges.has(k));
  if (badges.length) {
    rows.push([
      "Pending",
      badges.map((k) => `<span class="badge ${k}">${k}</span>`).join(" ") + ` <span class="since">since YYYY-MM-DD</span>`
    ]);
  }
  const tints = TINTS.filter((t) => ctx.used.tints.has(t));
  if (tints.length) {
    rows.push([
      "Tints",
      tints.map(
        (t) => `<span class="pill" style="background:var(--tint-${t}-bg);color:var(--tint-${t}-fg)">${t}</span>`
      ).join(" ") + " <span>ownership accents</span>"
    ]);
  }
  if (!rows.length) return "";
  const dl = rows.map(([dt, dd]) => `<dt>${dt}</dt>
<dd>${dd}</dd>`).join("\n");
  return `<details class="legend"><summary>How to read this</summary>
<dl>
${dl}
</dl>
</details>
`;
}
function assemblePage(ctx, md, bodyHtml) {
  const legend = buildLegend(ctx);
  const eyebrow = ctx.meta.eyebrow ? `<p class="eyebrow">${md.renderInline(ctx.meta.eyebrow)}</p>
` : "";
  const lede = ctx.meta.lede ? `<p class="lede">${md.renderInline(ctx.meta.lede)}</p>
` : "";
  const footer = ctx.meta.footer ? `<footer class="colophon">${md.renderInline(ctx.meta.footer)}</footer>
` : "";
  let body = bodyHtml;
  const afterH1 = lede + legend;
  if (body.includes("</h1>")) {
    if (afterH1) body = body.replace("</h1>", () => "</h1>\n" + afterH1);
    if (eyebrow) body = body.replace(/<h1\b/, () => eyebrow + "<h1");
  } else {
    body = eyebrow + lede + legend + body;
  }
  const scripts = [];
  if (ctx.usedMermaid) scripts.push(`<script src="${MERMAID_CDN}"></script>`);
  if (ctx.vegaSpecs.length)
    for (const url of VEGA_CDNS) scripts.push(`<script src="${url}"></script>`);
  if (ctx.usedMermaid || ctx.vegaSpecs.length) {
    const specsJson = JSON.stringify(ctx.vegaSpecs).replace(/</g, "\\u003c");
    const mmLight = JSON.stringify(mermaid_theme_default.themeVariables).replace(
      /</g,
      "\\u003c"
    );
    const mmDark = JSON.stringify(mermaid_theme_default._dark_themeVariables).replace(
      /</g,
      "\\u003c"
    );
    scripts.push(`<script>
document.addEventListener("DOMContentLoaded", function () {
  if (window.mermaid) {
    var dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    mermaid.initialize({
      startOnLoad: false,
      theme: "${mermaid_theme_default.theme}",
      themeVariables: dark ? ${mmDark} : ${mmLight}
    });
    mermaid.run();
  }
  var vegaSpecs = ${specsJson};
  if (window.vegaEmbed) vegaSpecs.forEach(function (v) { vegaEmbed("#" + v.id, v.spec, { actions: false }); });
});
</script>`);
  }
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- generated by design-render from ${escapeHtml2(ctx.mdBase)} \u2014 never hand-edit; design-schema-version: ${design_schema_default.version} -->
<title>${escapeHtml2(ctx.title)}</title>
<style>
${design_style_default.trim()}
</style>
</head>
<body>
${body}${footer}${scripts.length ? scripts.join("\n") + "\n" : ""}</body>
</html>
`;
}
function fail(msg) {
  process.stderr.write(`design-render: error: ${msg}
`);
  process.exit(2);
}
function report(ctx) {
  ctx.violations.sort((a, b) => a.line - b.line);
  for (const x3 of ctx.violations) {
    console.log(`${ctx.file}:${x3.line}: ${x3.what} \u2014 ${x3.why}`);
  }
  console.log(
    `design-render: ${ctx.violations.length} violation(s) in ${ctx.file}`
  );
}
async function main2() {
  const args = process.argv.slice(2);
  let check = false;
  const inputs = [];
  for (const a of args) {
    if (a === "--check") check = true;
    else if (a.startsWith("-"))
      fail(`unknown flag '${a}'
usage: design-render <design.md> [--check]`);
    else inputs.push(a);
  }
  if (inputs.length !== 1) fail("usage: design-render <design.md> [--check]");
  const mdPath = import_node_path.default.resolve(inputs[0]);
  let src;
  try {
    src = import_node_fs.default.readFileSync(mdPath, "utf8");
  } catch (e) {
    fail(`cannot read ${inputs[0]}: ${e.message}`);
  }
  const { body, offset, meta: meta3, metaLines } = stripFrontmatter(src);
  const ctx = {
    mdPath,
    mdDir: import_node_path.default.dirname(mdPath),
    mdBase: import_node_path.default.basename(mdPath),
    file: inputs[0],
    fmOffset: offset,
    bodyLines: body.split("\n"),
    meta: meta3,
    metaLines,
    violations: [],
    slugCounts: /* @__PURE__ */ new Map(),
    entryIds: /* @__PURE__ */ new Set(),
    vegaSpecs: [],
    vegaCount: 0,
    usedMermaid: false,
    used: {
      foundation: /* @__PURE__ */ new Set(),
      enf: /* @__PURE__ */ new Set(),
      badges: /* @__PURE__ */ new Set(),
      callouts: /* @__PURE__ */ new Set(),
      lenses: /* @__PURE__ */ new Set(),
      tints: /* @__PURE__ */ new Set(),
      combo: false,
      script: false,
      entryId: false,
      diagram: false
    },
    title: import_node_path.default.basename(mdPath)
  };
  const md = makeMd(ctx);
  const tokens2 = md.parse(body, {});
  for (let i2 = 0; i2 < tokens2.length; i2++) {
    if (tokens2[i2].type === "heading_open" && tokens2[i2].tag === "h1" && tokens2[i2].level === 0) {
      ctx.title = tokens2[i2 + 1].content;
      break;
    }
  }
  const nodes6 = segment(tokens2, ctx);
  await validate(ctx, md, nodes6, tokens2);
  if (ctx.violations.length) {
    report(ctx);
    process.exit(1);
  }
  const html3 = assemblePage(ctx, md, renderNodes(ctx, md, nodes6));
  const htmlPath = import_node_path.default.join(
    ctx.mdDir,
    import_node_path.default.basename(mdPath, import_node_path.default.extname(mdPath)) + ".html"
  );
  const htmlName = import_node_path.default.basename(htmlPath);
  if (check) {
    let existing = null;
    try {
      existing = import_node_fs.default.readFileSync(htmlPath);
    } catch {
    }
    if (existing === null) {
      console.log(
        `${ctx.file}:1: missing rendered ${htmlName} \u2014 run design-render to generate and commit it alongside the source`
      );
      process.exit(1);
    }
    if (!existing.equals(Buffer.from(html3, "utf8"))) {
      console.log(
        `${ctx.file}:1: stale rendered ${htmlName} \u2014 regenerating produces different bytes; re-run design-render and commit`
      );
      process.exit(1);
    }
    process.exit(0);
  }
  try {
    import_node_fs.default.writeFileSync(htmlPath, html3);
  } catch (e) {
    fail(`cannot write ${htmlPath}: ${e.message}`);
  }
  process.stderr.write(`design-render: wrote ${htmlPath}
`);
  process.exit(0);
}
main2().catch((e) => {
  process.stderr.write(`design-render: error: ${e && e.stack ? e.stack : e}
`);
  process.exit(2);
});
