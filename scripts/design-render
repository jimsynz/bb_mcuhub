      var y3 = 0;
      var usedW = 0;
      var rowH = 0;
      var maxRowW = Math.sqrt(totalA) * layoutInfo.clientWidth / layoutInfo.clientHeight;
      for (var i2 = 0; i2 < components3.length; i2++) {
        var c2 = components3[i2];
        if (!c2) {
          continue;
        }
        for (var j = 0; j < c2.length; j++) {
          var n = c2[j];
          if (!n.isLocked) {
            n.positionX += x3 - c2.x1;
            n.positionY += y3 - c2.y1;
          }
        }
        x3 += c2.w + options3.componentSpacing;
        usedW += c2.w + options3.componentSpacing;
        rowH = Math.max(rowH, c2.h);
        if (usedW > maxRowW) {
          y3 += rowH + options3.componentSpacing;
          x3 = 0;
          usedW = 0;
          rowH = 0;
        }
      }
    };
