// node_modules/markdown-it/lib/rules_inline/autolink.mjs
var EMAIL_RE = /^([a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*)$/;
var AUTOLINK_RE = /^([a-zA-Z][a-zA-Z0-9+.-]{1,31}):([^<>\x00-\x20]*)$/;
function autolink(state4, silent) {
  let pos = state4.pos;
  if (state4.src.charCodeAt(pos) !== 60) {
    return false;
  }
  const start3 = state4.pos;
  const max9 = state4.posMax;
  for (; ; ) {
    if (++pos >= max9) return false;
    const ch = state4.src.charCodeAt(pos);
    if (ch === 60) return false;
    if (ch === 62) break;
  }
  const url = state4.src.slice(start3 + 1, pos);
  if (AUTOLINK_RE.test(url)) {
    const fullUrl = state4.md.normalizeLink(url);
    if (!state4.md.validateLink(fullUrl)) {
      return false;
    }
    if (!silent) {
      const token_o = state4.push("link_open", "a", 1);
      token_o.attrs = [["href", fullUrl]];
      token_o.markup = "autolink";
      token_o.info = "auto";
      const token_t = state4.push("text", "", 0);
      token_t.content = state4.md.normalizeLinkText(url);
      const token_c = state4.push("link_close", "a", -1);
      token_c.markup = "autolink";
      token_c.info = "auto";
    }
    state4.pos += url.length + 2;
    return true;
  }
  if (EMAIL_RE.test(url)) {
    const fullUrl = state4.md.normalizeLink("mailto:" + url);
    if (!state4.md.validateLink(fullUrl)) {
      return false;
    }
    if (!silent) {
      const token_o = state4.push("link_open", "a", 1);
      token_o.attrs = [["href", fullUrl]];
      token_o.markup = "autolink";
      token_o.info = "auto";
      const token_t = state4.push("text", "", 0);
      token_t.content = state4.md.normalizeLinkText(url);
      const token_c = state4.push("link_close", "a", -1);
      token_c.markup = "autolink";
      token_c.info = "auto";
    }
    state4.pos += url.length + 2;
    return true;
  }
  return false;
}

// node_modules/markdown-it/lib/rules_inline/html_inline.mjs
function isLinkOpen2(str2) {
  return /^<a[>\s]/i.test(str2);
}
function isLinkClose2(str2) {
  return /^<\/a\s*>/i.test(str2);
}
function isLetter(ch) {
  const lc = ch | 32;
  return lc >= 97 && lc <= 122;
}
function html_inline(state4, silent) {
  if (!state4.md.options.html) {
    return false;
  }
  const max9 = state4.posMax;
  const pos = state4.pos;
  if (state4.src.charCodeAt(pos) !== 60 || pos + 2 >= max9) {
    return false;
  }
  const ch = state4.src.charCodeAt(pos + 1);
  if (ch !== 33 && ch !== 63 && ch !== 47 && !isLetter(ch)) {
    return false;
  }
  const match3 = state4.src.slice(pos).match(HTML_TAG_RE);
  if (!match3) {
    return false;
  }
  if (!silent) {
    const token2 = state4.push("html_inline", "", 0);
    token2.content = match3[0];
    if (isLinkOpen2(token2.content)) state4.linkLevel++;
    if (isLinkClose2(token2.content)) state4.linkLevel--;
  }
  state4.pos += match3[0].length;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/entity.mjs
init_esm();
var DIGITAL_RE = /^&#((?:x[a-f0-9]{1,6}|[0-9]{1,7}));/i;
var NAMED_RE = /^&([a-z][a-z0-9]{1,31});/i;
function entity(state4, silent) {
  const pos = state4.pos;
  const max9 = state4.posMax;
  if (state4.src.charCodeAt(pos) !== 38) return false;
  if (pos + 1 >= max9) return false;
  const ch = state4.src.charCodeAt(pos + 1);
  if (ch === 35) {
    const match3 = state4.src.slice(pos).match(DIGITAL_RE);
    if (match3) {
      if (!silent) {
        const code2 = match3[1][0].toLowerCase() === "x" ? parseInt(match3[1].slice(1), 16) : parseInt(match3[1], 10);
        const token2 = state4.push("text_special", "", 0);
        token2.content = isValidEntityCode(code2) ? fromCodePoint2(code2) : fromCodePoint2(65533);
        token2.markup = match3[0];
        token2.info = "entity";
      }
      state4.pos += match3[0].length;
      return true;
    }
  } else {
    const match3 = state4.src.slice(pos).match(NAMED_RE);
    if (match3) {
      const decoded = decodeHTML(match3[0]);
      if (decoded !== match3[0]) {
        if (!silent) {
          const token2 = state4.push("text_special", "", 0);
          token2.content = decoded;
          token2.markup = match3[0];
          token2.info = "entity";
        }
        state4.pos += match3[0].length;
        return true;
      }
    }
  }
  return false;
}

// node_modules/markdown-it/lib/rules_inline/balance_pairs.mjs
function processDelimiters(delimiters2) {
  const openersBottom = {};
  const max9 = delimiters2.length;
  if (!max9) return;
  let headerIdx = 0;
  let lastTokenIdx = -2;
  const jumps = [];
  for (let closerIdx = 0; closerIdx < max9; closerIdx++) {
    const closer = delimiters2[closerIdx];
    jumps.push(0);
    if (delimiters2[headerIdx].marker !== closer.marker || lastTokenIdx !== closer.token - 1) {
      headerIdx = closerIdx;
    }
    lastTokenIdx = closer.token;
    closer.length = closer.length || 0;
    if (!closer.close) continue;
    if (!openersBottom.hasOwnProperty(closer.marker)) {
      openersBottom[closer.marker] = [-1, -1, -1, -1, -1, -1];
    }
    const minOpenerIdx = openersBottom[closer.marker][(closer.open ? 3 : 0) + closer.length % 3];
    let openerIdx = headerIdx - jumps[headerIdx] - 1;
    let newMinOpenerIdx = openerIdx;
    for (; openerIdx > minOpenerIdx; openerIdx -= jumps[openerIdx] + 1) {
      const opener = delimiters2[openerIdx];
      if (opener.marker !== closer.marker) continue;
      if (opener.open && opener.end < 0) {
        let isOddMatch = false;
        if (opener.close || closer.open) {
          if ((opener.length + closer.length) % 3 === 0) {
            if (opener.length % 3 !== 0 || closer.length % 3 !== 0) {
              isOddMatch = true;
            }
          }
        }
        if (!isOddMatch) {
          const lastJump = openerIdx > 0 && !delimiters2[openerIdx - 1].open ? jumps[openerIdx - 1] + 1 : 0;
          jumps[closerIdx] = closerIdx - openerIdx + lastJump;
          jumps[openerIdx] = lastJump;
          closer.open = false;
          opener.end = closerIdx;
          opener.close = false;
          newMinOpenerIdx = -1;
          lastTokenIdx = -2;
          break;
        }
      }
    }
    if (newMinOpenerIdx !== -1) {
      openersBottom[closer.marker][(closer.open ? 3 : 0) + (closer.length || 0) % 3] = newMinOpenerIdx;
    }
  }
}
function link_pairs(state4) {
  const tokens_meta = state4.tokens_meta;
  const max9 = state4.tokens_meta.length;
  processDelimiters(state4.delimiters);
  for (let curr = 0; curr < max9; curr++) {
    if (tokens_meta[curr] && tokens_meta[curr].delimiters) {
      processDelimiters(tokens_meta[curr].delimiters);
    }
  }
}

// node_modules/markdown-it/lib/rules_inline/fragments_join.mjs
function fragments_join(state4) {
  let curr, last4;
  let level = 0;
  const tokens2 = state4.tokens;
  const max9 = state4.tokens.length;
  for (curr = last4 = 0; curr < max9; curr++) {
    if (tokens2[curr].nesting < 0) level--;
    tokens2[curr].level = level;
    if (tokens2[curr].nesting > 0) level++;
    if (tokens2[curr].type === "text" && curr + 1 < max9 && tokens2[curr + 1].type === "text") {
      tokens2[curr + 1].content = tokens2[curr].content + tokens2[curr + 1].content;
    } else {
      if (curr !== last4) {
        tokens2[last4] = tokens2[curr];
      }
      last4++;
    }
  }
  if (curr !== last4) {
    tokens2.length = last4;
  }
}

// node_modules/markdown-it/lib/parser_inline.mjs
var _rules3 = [
  ["text", text],
  ["linkify", linkify2],
  ["newline", newline],
  ["escape", escape3],
  ["backticks", backtick],
  ["strikethrough", strikethrough_default.tokenize],
  ["emphasis", emphasis_default.tokenize],
  ["link", link],
  ["image", image],
  ["autolink", autolink],
  ["html_inline", html_inline],
  ["entity", entity]
];
var _rules22 = [
  ["balance_pairs", link_pairs],
  ["strikethrough", strikethrough_default.postProcess],
  ["emphasis", emphasis_default.postProcess],
  // rules for pairs separate '**' into its own text tokens, which may be left unused,
  // rule below merges unused segments back with the rest of the text
  ["fragments_join", fragments_join]
];
function ParserInline() {
  this.ruler = new ruler_default();
  for (let i2 = 0; i2 < _rules3.length; i2++) {
    this.ruler.push(_rules3[i2][0], _rules3[i2][1]);
  }
  this.ruler2 = new ruler_default();
  for (let i2 = 0; i2 < _rules22.length; i2++) {
    this.ruler2.push(_rules22[i2][0], _rules22[i2][1]);
  }
}
ParserInline.prototype.skipToken = function(state4) {
  const pos = state4.pos;
  const rules = this.ruler.getRules("");
  const len = rules.length;
  const maxNesting = state4.md.options.maxNesting;
  const cache3 = state4.cache;
  if (typeof cache3[pos] !== "undefined") {
    state4.pos = cache3[pos];
    return;
  }
  let ok = false;
  if (state4.level < maxNesting) {
    for (let i2 = 0; i2 < len; i2++) {
      state4.level++;
      ok = rules[i2](state4, true);
      state4.level--;
      if (ok) {
        if (pos >= state4.pos) {
          throw new Error("inline rule didn't increment state.pos");
        }
        break;
      }
    }
  } else {
    state4.pos = state4.posMax;
  }
  if (!ok) {
    state4.pos++;
  }
  cache3[pos] = state4.pos;
};
ParserInline.prototype.tokenize = function(state4) {
  const rules = this.ruler.getRules("");
  const len = rules.length;
  const end2 = state4.posMax;
  const maxNesting = state4.md.options.maxNesting;
  while (state4.pos < end2) {
    const prevPos = state4.pos;
    let ok = false;
    if (state4.level < maxNesting) {
      for (let i2 = 0; i2 < len; i2++) {
        ok = rules[i2](state4, false);
        if (ok) {
          if (prevPos >= state4.pos) {
            throw new Error("inline rule didn't increment state.pos");
          }
          break;
        }
      }
    }
    if (ok) {
      if (state4.pos >= end2) {
        break;
      }
      continue;
    }
    state4.pending += state4.src[state4.pos++];
  }
  if (state4.pending) {
    state4.pushPending();
  }
};
ParserInline.prototype.parse = function(str2, md, env, outTokens) {
  const state4 = new this.State(str2, md, env, outTokens);
  this.tokenize(state4);
  const rules = this.ruler2.getRules("");
  const len = rules.length;
  for (let i2 = 0; i2 < len; i2++) {
    rules[i2](state4);
  }
};
ParserInline.prototype.State = state_inline_default;
var parser_inline_default = ParserInline;

// node_modules/linkify-it/lib/re.mjs
function re_default(opts) {
  const re2 = {};
  opts = opts || {};
  re2.src_Any = regex_default.source;
  re2.src_Cc = regex_default2.source;
  re2.src_Z = regex_default6.source;
  re2.src_P = regex_default4.source;
  re2.src_ZPCc = [re2.src_Z, re2.src_P, re2.src_Cc].join("|");
  re2.src_ZCc = [re2.src_Z, re2.src_Cc].join("|");
  const text_separators = "[><\uFF5C]";
  re2.src_pseudo_letter = `(?:(?!${text_separators}|${re2.src_ZPCc})${re2.src_Any})`;
  re2.src_ip4 = "(?:(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)";
  re2.src_auth = `(?:(?:(?!${re2.src_ZCc}|[@/\\[\\]()]).){1,50}@)?`;
  re2.src_port = "(?::(?:6(?:[0-4]\\d{3}|5(?:[0-4]\\d{2}|5(?:[0-2]\\d|3[0-5])))|[1-5]?\\d{1,4}))?";
