        availableHeight -= spaceUsed.height;
        spaceUsed = this.componentStore.title.calculateSpace({
          width: this.chartConfig.width,
          height: availableHeight
        });
        plotY = spaceUsed.height;
        availableHeight -= spaceUsed.height;
