    coverage_map: {
      what: "the answer to 'is any part of the system blind to the design'. docs/COVERAGE.md (its declared home \u2014 see homing), referenced from the entry points: a table listing every meaningful system part with a status and a pointer.",
      statuses: {
        captured: "a design unit describes this part at reproduction grade \u2014 the row links the owning design-document section or context",
