      // implements /\n|\r\n?/g.test
      test: function(text5) {
        const len = text5.length;
        for (let i2 = this.lastIndex; i2 < len; i2++) {
          const c2 = text5.charCodeAt(i2);
          if (c2 === 10) {
            this.lastIndex = i2 + 1;
            return true;
          } else if (c2 === 13) {
            if (text5.charCodeAt(i2 + 1) === 10) {
