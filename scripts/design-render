// node_modules/dagre-d3-es/src/dagre/rank/network-simplex.js
function networkSimplex(g) {
  g = simplify(g);
  longestPath(g);
  var t = feasibleTree(g);
  initLowLimValues(t);
  initCutValues(t, g);
  var e, f;
  while (e = leaveEdge(t)) {
    f = enterEdge(t, g, e);
    exchangeEdges(t, g, e, f);
  }
}
function initCutValues(t, g) {
  var vs = postorder(t, t.nodes());
  vs = vs.slice(0, vs.length - 1);
  forEach_default(vs, function(v) {
    assignCutValue(t, g, v);
  });
}
function assignCutValue(t, g, child) {
  var childLab = t.node(child);
  var parent4 = childLab.parent;
  t.edge(child, parent4).cutvalue = calcCutValue(t, g, child);
}
function calcCutValue(t, g, child) {
  var childLab = t.node(child);
  var parent4 = childLab.parent;
  var childIsTail = true;
  var graphEdge = g.edge(child, parent4);
  var cutValue = 0;
  if (!graphEdge) {
    childIsTail = false;
    graphEdge = g.edge(parent4, child);
  }
  cutValue = graphEdge.weight;
  forEach_default(g.nodeEdges(child), function(e) {
    var isOutEdge = e.v === child, other2 = isOutEdge ? e.w : e.v;
    if (other2 !== parent4) {
      var pointsToHead = isOutEdge === childIsTail, otherWeight = g.edge(e).weight;
      cutValue += pointsToHead ? otherWeight : -otherWeight;
      if (isTreeEdge(t, child, other2)) {
        var otherCutValue = t.edge(child, other2).cutvalue;
        cutValue += pointsToHead ? -otherCutValue : otherCutValue;
      }
    }
  });
  return cutValue;
}
function initLowLimValues(tree, root5) {
  if (arguments.length < 2) {
    root5 = tree.nodes()[0];
  }
  dfsAssignLowLim(tree, {}, 1, root5);
}
function dfsAssignLowLim(tree, visited, nextLim, v, parent4) {
  var low = nextLim;
  var label = tree.node(v);
  visited[v] = true;
  forEach_default(tree.neighbors(v), function(w2) {
    if (!Object.prototype.hasOwnProperty.call(visited, w2)) {
      nextLim = dfsAssignLowLim(tree, visited, nextLim, w2, v);
    }
  });
  label.low = low;
  label.lim = nextLim++;
  if (parent4) {
    label.parent = parent4;
  } else {
    delete label.parent;
  }
  return nextLim;
}
function leaveEdge(tree) {
  return find_default(tree.edges(), function(e) {
    return tree.edge(e).cutvalue < 0;
  });
}
function enterEdge(t, g, edge) {
  var v = edge.v;
  var w2 = edge.w;
  if (!g.hasEdge(v, w2)) {
    v = edge.w;
    w2 = edge.v;
  }
  var vLabel = t.node(v);
  var wLabel = t.node(w2);
  var tailLabel = vLabel;
  var flip = false;
  if (vLabel.lim > wLabel.lim) {
    tailLabel = wLabel;
    flip = true;
  }
  var candidates = filter_default3(g.edges(), function(edge2) {
    return flip === isDescendant(t, t.node(edge2.v), tailLabel) && flip !== isDescendant(t, t.node(edge2.w), tailLabel);
  });
  return minBy_default(candidates, function(edge2) {
    return slack(g, edge2);
  });
}
function exchangeEdges(t, g, e, f) {
  var v = e.v;
  var w2 = e.w;
  t.removeEdge(v, w2);
  t.setEdge(f.v, f.w, {});
  initLowLimValues(t);
  initCutValues(t, g);
  updateRanks(t, g);
}
function updateRanks(t, g) {
  var root5 = find_default(t.nodes(), function(v) {
    return !g.node(v).parent;
  });
  var vs = preorder(t, root5);
  vs = vs.slice(1);
  forEach_default(vs, function(v) {
    var parent4 = t.node(v).parent, edge = g.edge(v, parent4), flipped = false;
    if (!edge) {
      edge = g.edge(parent4, v);
      flipped = true;
    }
    g.node(v).rank = g.node(parent4).rank + (flipped ? edge.minlen : -edge.minlen);
  });
}
function isTreeEdge(tree, u, v) {
  return tree.hasEdge(u, v);
}
function isDescendant(tree, vLabel, rootLabel) {
  return rootLabel.low <= vLabel.lim && vLabel.lim <= rootLabel.lim;
}
