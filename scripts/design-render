          lastCharIsLT = lastLTIdx === imageLength - 1;
          fixForEndingInLT = lastCharIsLT ? -1 : 0;
          if (!(numOfLTsInMatch === 1 && lastCharIsLT === true)) {
            newToken.endLine = line2 + fixForEndingInLT;
            newToken.endColumn = column2 - 1 + -fixForEndingInLT;
          }
        }
      }
      computeNewColumn(oldColumn, imageLength) {
        return oldColumn + imageLength;
      }
      createOffsetOnlyToken(image2, startOffset, tokenTypeIdx, tokenType) {
        return {
          image: image2,
          startOffset,
          tokenTypeIdx,
          tokenType
        };
      }
      createStartOnlyToken(image2, startOffset, tokenTypeIdx, tokenType, startLine, startColumn) {
        return {
          image: image2,
          startOffset,
          startLine,
          startColumn,
          tokenTypeIdx,
          tokenType
        };
      }
      createFullToken(image2, startOffset, tokenTypeIdx, tokenType, startLine, startColumn, imageLength) {
        return {
          image: image2,
          startOffset,
          endOffset: startOffset + imageLength - 1,
          startLine,
          endLine: startLine,
          startColumn,
          endColumn: startColumn + imageLength - 1,
          tokenTypeIdx,
          tokenType
        };
      }
      addTokenUsingPush(tokenVector, index, tokenToAdd) {
        tokenVector.push(tokenToAdd);
        return index;
      }
      addTokenUsingMemberAccess(tokenVector, index, tokenToAdd) {
        tokenVector[index] = tokenToAdd;
        index++;
        return index;
      }
      handlePayloadNoCustom(token2, payload) {
      }
      handlePayloadWithCustom(token2, payload) {
        if (payload !== null) {
          token2.payload = payload;
        }
      }
      matchWithTest(pattern, text5, offset) {
        const found = pattern.test(text5);
        if (found === true) {
          return text5.substring(offset, pattern.lastIndex);
        }
        return null;
      }
      matchWithExec(pattern, text5) {
        const regExpArray = pattern.exec(text5);
        return regExpArray !== null ? regExpArray[0] : null;
      }
    };
    Lexer2.SKIPPED = "This marks a skipped Token pattern, this means each token identified by it willbe consumed and then thrown into oblivion, this can be used to for example to completely ignore whitespace.";
    Lexer2.NA = /NOT_APPLICABLE/;
  }
});

// node_modules/chevrotain/lib/src/scan/tokens_public.js
function tokenLabel2(tokType) {
  if (hasTokenLabel2(tokType)) {
    return tokType.LABEL;
  } else {
    return tokType.name;
  }
}
function hasTokenLabel2(obj) {
  return isString_default2(obj.LABEL) && obj.LABEL !== "";
}
function createToken(config6) {
  return createTokenInternal(config6);
}
function createTokenInternal(config6) {
  const pattern = config6.pattern;
  const tokenType = {};
  tokenType.name = config6.name;
  if (!isUndefined_default2(pattern)) {
    tokenType.PATTERN = pattern;
  }
  if (has_default2(config6, PARENT)) {
    throw "The parent property is no longer supported.\nSee: https://github.com/chevrotain/chevrotain/issues/564#issuecomment-349062346 for details.";
  }
  if (has_default2(config6, CATEGORIES)) {
    tokenType.CATEGORIES = config6[CATEGORIES];
  }
  augmentTokenTypes([tokenType]);
  if (has_default2(config6, LABEL)) {
    tokenType.LABEL = config6[LABEL];
  }
  if (has_default2(config6, GROUP)) {
    tokenType.GROUP = config6[GROUP];
  }
  if (has_default2(config6, POP_MODE)) {
    tokenType.POP_MODE = config6[POP_MODE];
  }
  if (has_default2(config6, PUSH_MODE)) {
    tokenType.PUSH_MODE = config6[PUSH_MODE];
  }
  if (has_default2(config6, LONGER_ALT)) {
    tokenType.LONGER_ALT = config6[LONGER_ALT];
  }
  if (has_default2(config6, LINE_BREAKS)) {
    tokenType.LINE_BREAKS = config6[LINE_BREAKS];
  }
  if (has_default2(config6, START_CHARS_HINT)) {
    tokenType.START_CHARS_HINT = config6[START_CHARS_HINT];
  }
  return tokenType;
}
function createTokenInstance(tokType, image2, startOffset, endOffset, startLine, endLine, startColumn, endColumn) {
  return {
    image: image2,
    startOffset,
    endOffset,
    startLine,
    endLine,
    startColumn,
    endColumn,
    tokenTypeIdx: tokType.tokenTypeIdx,
    tokenType: tokType
  };
}
function tokenMatcher(token2, tokType) {
  return tokenStructuredMatcher(token2, tokType);
}
