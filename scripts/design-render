// node_modules/dagre-d3-es/src/dagre/order/build-layer-graph.js
function buildLayerGraph(g, rank2, relationship) {
  var root5 = createRootNode(g), result = new Graph({ compound: true }).setGraph({ root: root5 }).setDefaultNodeLabel(function(v) {
    return g.node(v);
  });
  forEach_default(g.nodes(), function(v) {
    var node2 = g.node(v), parent4 = g.parent(v);
    if (node2.rank === rank2 || node2.minRank <= rank2 && rank2 <= node2.maxRank) {
      result.setNode(v);
      result.setParent(v, parent4 || root5);
      forEach_default(g[relationship](v), function(e) {
        var u = e.v === v ? e.w : e.v, edge = result.edge(u, v), weight8 = !isUndefined_default(edge) ? edge.weight : 0;
        result.setEdge(u, v, { weight: g.edge(e).weight + weight8 });
      });
      if (Object.prototype.hasOwnProperty.call(node2, "minRank")) {
        result.setNode(v, {
          borderLeft: node2.borderLeft[rank2],
          borderRight: node2.borderRight[rank2]
        });
      }
    }
  });
  return result;
}
function createRootNode(g) {
  var v;
  while (g.hasNode(v = uniqueId_default("_root"))) ;
  return v;
}
