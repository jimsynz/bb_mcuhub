async function linedCylinder(parent4, node2) {
  const { labelStyles, nodeStyles } = styles2String(node2);
  node2.labelStyle = labelStyles;
  const { shapeSvg, bbox, label } = await labelHelper(parent4, node2, getNodeClasses(node2));
  const w2 = Math.max(bbox.width + (node2.padding ?? 0), node2.width ?? 0);
  const rx = w2 / 2;
  const ry = rx / (2.5 + w2 / 50);
  const h = Math.max(bbox.height + ry + (node2.padding ?? 0), node2.height ?? 0);
  const outerOffset = h * 0.1;
  let cylinder22;
  const { cssStyles } = node2;
  if (node2.look === "handDrawn") {
    const rc = import_roughjs31.default.svg(shapeSvg);
    const outerPathData = createOuterCylinderPathD2(0, 0, w2, h, rx, ry, outerOffset);
    const innerPathData = createInnerCylinderPathD2(0, ry, w2, h, rx, ry);
    const options3 = userNodeOverrides(node2, {});
    const outerNode = rc.path(outerPathData, options3);
    const innerLine = rc.path(innerPathData, options3);
    const innerLineEl = shapeSvg.insert(() => innerLine, ":first-child");
    innerLineEl.attr("class", "line");
    cylinder22 = shapeSvg.insert(() => outerNode, ":first-child");
    cylinder22.attr("class", "basic label-container");
    if (cssStyles) {
      cylinder22.attr("style", cssStyles);
    }
  } else {
    const pathData = createCylinderPathD2(0, 0, w2, h, rx, ry, outerOffset);
    cylinder22 = shapeSvg.insert("path", ":first-child").attr("d", pathData).attr("class", "basic label-container").attr("style", handleUndefinedAttr(cssStyles)).attr("style", nodeStyles);
  }
  cylinder22.attr("label-offset-y", ry);
  cylinder22.attr("transform", `translate(${-w2 / 2}, ${-(h / 2 + ry)})`);
  updateNodeBounds(node2, cylinder22);
  label.attr(
    "transform",
    `translate(${-(bbox.width / 2) - (bbox.x - (bbox.left ?? 0))}, ${-(bbox.height / 2) + ry - (bbox.y - (bbox.top ?? 0))})`
  );
  node2.intersect = function(point8) {
    const pos = intersect_default.rect(node2, point8);
    const x3 = pos.x - (node2.x ?? 0);
    if (rx != 0 && (Math.abs(x3) < (node2.width ?? 0) / 2 || Math.abs(x3) == (node2.width ?? 0) / 2 && Math.abs(pos.y - (node2.y ?? 0)) > (node2.height ?? 0) / 2 - ry)) {
      let y3 = ry * ry * (1 - x3 * x3 / (rx * rx));
      if (y3 > 0) {
        y3 = Math.sqrt(y3);
      }
      y3 = ry - y3;
      if (point8.y - (node2.y ?? 0) > 0) {
        y3 = -y3;
      }
      pos.y += y3;
    }
    return pos;
  };
  return shapeSvg;
}
async function linedWaveEdgedRect(parent4, node2) {
  const { labelStyles, nodeStyles } = styles2String(node2);
  node2.labelStyle = labelStyles;
  const { shapeSvg, bbox, label } = await labelHelper(parent4, node2, getNodeClasses(node2));
  const w2 = Math.max(bbox.width + (node2.padding ?? 0) * 2, node2?.width ?? 0);
  const h = Math.max(bbox.height + (node2.padding ?? 0) * 2, node2?.height ?? 0);
  const waveAmplitude = h / 4;
  const finalH = h + waveAmplitude;
  const { cssStyles } = node2;
  const rc = import_roughjs32.default.svg(shapeSvg);
  const options3 = userNodeOverrides(node2, {});
  if (node2.look !== "handDrawn") {
    options3.roughness = 0;
    options3.fillStyle = "solid";
  }
  const points = [
    { x: -w2 / 2 - w2 / 2 * 0.1, y: -finalH / 2 },
    { x: -w2 / 2 - w2 / 2 * 0.1, y: finalH / 2 },
    ...generateFullSineWavePoints(
      -w2 / 2 - w2 / 2 * 0.1,
      finalH / 2,
      w2 / 2 + w2 / 2 * 0.1,
      finalH / 2,
      waveAmplitude,
      0.8
    ),
    { x: w2 / 2 + w2 / 2 * 0.1, y: -finalH / 2 },
    { x: -w2 / 2 - w2 / 2 * 0.1, y: -finalH / 2 },
    { x: -w2 / 2, y: -finalH / 2 },
    { x: -w2 / 2, y: finalH / 2 * 1.1 },
    { x: -w2 / 2, y: -finalH / 2 }
  ];
  const poly = rc.polygon(
    points.map((p2) => [p2.x, p2.y]),
    options3
  );
  const waveEdgeRect = shapeSvg.insert(() => poly, ":first-child");
  waveEdgeRect.attr("class", "basic label-container");
  if (cssStyles && node2.look !== "handDrawn") {
    waveEdgeRect.selectAll("path").attr("style", cssStyles);
  }
  if (nodeStyles && node2.look !== "handDrawn") {
    waveEdgeRect.selectAll("path").attr("style", nodeStyles);
  }
  waveEdgeRect.attr("transform", `translate(0,${-waveAmplitude / 2})`);
  label.attr(
    "transform",
    `translate(${-w2 / 2 + (node2.padding ?? 0) + w2 / 2 * 0.1 / 2 - (bbox.x - (bbox.left ?? 0))},${-h / 2 + (node2.padding ?? 0) - waveAmplitude / 2 - (bbox.y - (bbox.top ?? 0))})`
  );
  updateNodeBounds(node2, waveEdgeRect);
  node2.intersect = function(point8) {
    const pos = intersect_default.polygon(node2, points, point8);
    return pos;
  };
  return shapeSvg;
}
async function multiRect(parent4, node2) {
  const { labelStyles, nodeStyles } = styles2String(node2);
  node2.labelStyle = labelStyles;
  const { shapeSvg, bbox, label } = await labelHelper(parent4, node2, getNodeClasses(node2));
  const w2 = Math.max(bbox.width + (node2.padding ?? 0) * 2, node2?.width ?? 0);
  const h = Math.max(bbox.height + (node2.padding ?? 0) * 2, node2?.height ?? 0);
  const rectOffset = 5;
  const x3 = -w2 / 2;
  const y3 = -h / 2;
  const { cssStyles } = node2;
  const rc = import_roughjs33.default.svg(shapeSvg);
  const options3 = userNodeOverrides(node2, {});
  const outerPathPoints = [
    { x: x3 - rectOffset, y: y3 + rectOffset },
    { x: x3 - rectOffset, y: y3 + h + rectOffset },
    { x: x3 + w2 - rectOffset, y: y3 + h + rectOffset },
    { x: x3 + w2 - rectOffset, y: y3 + h },
    { x: x3 + w2, y: y3 + h },
    { x: x3 + w2, y: y3 + h - rectOffset },
    { x: x3 + w2 + rectOffset, y: y3 + h - rectOffset },
    { x: x3 + w2 + rectOffset, y: y3 - rectOffset },
    { x: x3 + rectOffset, y: y3 - rectOffset },
    { x: x3 + rectOffset, y: y3 },
    { x: x3, y: y3 },
    { x: x3, y: y3 + rectOffset }
  ];
  const innerPathPoints = [
    { x: x3, y: y3 + rectOffset },
    { x: x3 + w2 - rectOffset, y: y3 + rectOffset },
    { x: x3 + w2 - rectOffset, y: y3 + h },
    { x: x3 + w2, y: y3 + h },
    { x: x3 + w2, y: y3 },
    { x: x3, y: y3 }
  ];
  if (node2.look !== "handDrawn") {
    options3.roughness = 0;
    options3.fillStyle = "solid";
  }
  const outerPath = createPathFromPoints(outerPathPoints);
  const outerNode = rc.path(outerPath, options3);
  const innerPath3 = createPathFromPoints(innerPathPoints);
  const innerNode = rc.path(innerPath3, { ...options3, fill: "none" });
  const multiRect2 = shapeSvg.insert(() => innerNode, ":first-child");
  multiRect2.insert(() => outerNode, ":first-child");
  multiRect2.attr("class", "basic label-container");
  if (cssStyles && node2.look !== "handDrawn") {
    multiRect2.selectAll("path").attr("style", cssStyles);
  }
  if (nodeStyles && node2.look !== "handDrawn") {
    multiRect2.selectAll("path").attr("style", nodeStyles);
  }
  label.attr(
    "transform",
    `translate(${-(bbox.width / 2) - rectOffset - (bbox.x - (bbox.left ?? 0))}, ${-(bbox.height / 2) + rectOffset - (bbox.y - (bbox.top ?? 0))})`
  );
  updateNodeBounds(node2, multiRect2);
  node2.intersect = function(point8) {
    const pos = intersect_default.polygon(node2, outerPathPoints, point8);
    return pos;
  };
  return shapeSvg;
}
async function multiWaveEdgedRectangle(parent4, node2) {
  const { labelStyles, nodeStyles } = styles2String(node2);
  node2.labelStyle = labelStyles;
  const { shapeSvg, bbox, label } = await labelHelper(parent4, node2, getNodeClasses(node2));
