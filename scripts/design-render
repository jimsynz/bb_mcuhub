      if (startBlock?.size && endBlock?.size) {
        const start22 = startBlock.size;
        const end2 = endBlock.size;
        const points = [
          { x: start22.x, y: start22.y },
          { x: start22.x + (end2.x - start22.x) / 2, y: start22.y + (end2.y - start22.y) / 2 },
          { x: end2.x, y: end2.y }
        ];
        insertEdge2(
          elem,
          { v: edge.start, w: edge.end, name: edge.id },
          {
            ...edge,
