async function tiltedCylinder(parent4, node2) {
  const { labelStyles, nodeStyles } = styles2String(node2);
  node2.labelStyle = labelStyles;
  const { shapeSvg, bbox, label, halfPadding } = await labelHelper(
    parent4,
    node2,
    getNodeClasses(node2)
  );
  const labelPadding = node2.look === "neo" ? halfPadding * 2 : halfPadding;
  const h = bbox.height + labelPadding;
  const ry = h / 2;
  const rx = ry / (2.5 + h / 50);
  const w2 = bbox.width + rx + labelPadding;
  const { cssStyles } = node2;
  let cylinder22;
  if (node2.look === "handDrawn") {
    const rc = import_roughjs47.default.svg(shapeSvg);
    const outerPathData = createOuterCylinderPathD3(0, 0, w2, h, rx, ry);
    const innerPathData = createInnerCylinderPathD3(0, 0, w2, h, rx, ry);
    const outerNode = rc.path(outerPathData, userNodeOverrides(node2, {}));
    const innerLine = rc.path(innerPathData, userNodeOverrides(node2, { fill: "none" }));
    cylinder22 = shapeSvg.insert(() => innerLine, ":first-child");
    cylinder22 = shapeSvg.insert(() => outerNode, ":first-child");
    cylinder22.attr("class", "basic label-container");
    if (cssStyles) {
      cylinder22.attr("style", cssStyles);
    }
  } else {
    const pathData = createCylinderPathD3(0, 0, w2, h, rx, ry);
    cylinder22 = shapeSvg.insert("path", ":first-child").attr("d", pathData).attr("class", "basic label-container").attr("style", handleUndefinedAttr(cssStyles)).attr("style", nodeStyles);
    cylinder22.attr("class", "basic label-container");
    if (cssStyles) {
      cylinder22.selectAll("path").attr("style", cssStyles);
    }
    if (nodeStyles) {
      cylinder22.selectAll("path").attr("style", nodeStyles);
    }
  }
  cylinder22.attr("label-offset-x", rx);
  cylinder22.attr("transform", `translate(${-w2 / 2}, ${h / 2} )`);
  label.attr(
    "transform",
    `translate(${-(bbox.width / 2) - rx - (bbox.x - (bbox.left ?? 0))}, ${-(bbox.height / 2) - (bbox.y - (bbox.top ?? 0))})`
  );
  updateNodeBounds(node2, cylinder22);
  node2.intersect = function(point8) {
    const pos = intersect_default.rect(node2, point8);
    const y3 = pos.y - (node2.y ?? 0);
    if (ry != 0 && (Math.abs(y3) < (node2.height ?? 0) / 2 || Math.abs(y3) == (node2.height ?? 0) / 2 && Math.abs(pos.x - (node2.x ?? 0)) > (node2.width ?? 0) / 2 - rx)) {
      let x3 = rx * rx * (1 - y3 * y3 / (ry * ry));
      if (x3 != 0) {
        x3 = Math.sqrt(Math.abs(x3));
      }
      x3 = rx - x3;
      if (point8.x - (node2.x ?? 0) > 0) {
        x3 = -x3;
      }
      pos.x += x3;
    }
    return pos;
  };
  return shapeSvg;
}
