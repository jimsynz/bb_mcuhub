  const halfPadding = node2?.padding ?? 0;
  const w2 = Math.max(bbox.width + (node2.padding ?? 0) * 2, node2?.width ?? 0);
  const h = Math.max(bbox.height + (node2.padding ?? 0) * 2, node2?.height ?? 0);
  const x3 = -bbox.width / 2 - halfPadding;
  const y3 = -bbox.height / 2 - halfPadding;
  const { cssStyles } = node2;
  const rc = import_roughjs39.default.svg(shapeSvg);
  const options3 = userNodeOverrides(node2, {});
  if (node2.look !== "handDrawn") {
    options3.roughness = 0;
    options3.fillStyle = "solid";
  }
  const points = [
    { x: x3, y: y3 },
    { x: x3 + w2 + 8, y: y3 },
    { x: x3 + w2 + 8, y: y3 + h },
    { x: x3 - 8, y: y3 + h },
    { x: x3 - 8, y: y3 },
    { x: x3, y: y3 },
    { x: x3, y: y3 + h }
  ];
  const roughNode = rc.polygon(
    points.map((p2) => [p2.x, p2.y]),
    options3
  );
  const rect22 = shapeSvg.insert(() => roughNode, ":first-child");
