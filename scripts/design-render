// node_modules/markdown-it/lib/helpers/parse_link_label.mjs
function parseLinkLabel(state4, start3, disableNested) {
  let level, found, marker, prevPos;
  const max9 = state4.posMax;
  const oldPos = state4.pos;
  state4.pos = start3 + 1;
  level = 1;
  while (state4.pos < max9) {
    marker = state4.src.charCodeAt(state4.pos);
    if (marker === 93) {
      level--;
      if (level === 0) {
        found = true;
        break;
      }
    }
    prevPos = state4.pos;
    state4.md.inline.skipToken(state4);
    if (marker === 91) {
      if (prevPos === state4.pos - 1) {
        level++;
      } else if (disableNested) {
        state4.pos = oldPos;
        return -1;
      }
    }
  }
  let labelEnd = -1;
  if (found) {
    labelEnd = state4.pos;
  }
  state4.pos = oldPos;
  return labelEnd;
}

// node_modules/markdown-it/lib/helpers/parse_link_destination.mjs
function parseLinkDestination(str2, start3, max9) {
  let code2;
  let pos = start3;
  const result = {
    ok: false,
    pos: 0,
    str: ""
  };
  if (str2.charCodeAt(pos) === 60) {
    pos++;
    while (pos < max9) {
      code2 = str2.charCodeAt(pos);
      if (code2 === 10) {
        return result;
      }
      if (code2 === 60) {
        return result;
      }
      if (code2 === 62) {
        result.pos = pos + 1;
        result.str = unescapeAll(str2.slice(start3 + 1, pos));
        result.ok = true;
        return result;
      }
      if (code2 === 92 && pos + 1 < max9) {
        pos += 2;
        continue;
      }
      pos++;
    }
    return result;
  }
  let level = 0;
  while (pos < max9) {
    code2 = str2.charCodeAt(pos);
    if (code2 === 32) {
      break;
    }
    if (code2 < 32 || code2 === 127) {
      break;
    }
    if (code2 === 92 && pos + 1 < max9) {
      if (str2.charCodeAt(pos + 1) === 32) {
        break;
      }
      pos += 2;
      continue;
    }
    if (code2 === 40) {
      level++;
      if (level > 32) {
        return result;
      }
    }
    if (code2 === 41) {
      if (level === 0) {
        break;
      }
      level--;
    }
    pos++;
  }
  if (start3 === pos) {
    return result;
  }
  if (level !== 0) {
    return result;
  }
  result.str = unescapeAll(str2.slice(start3, pos));
  result.pos = pos;
  result.ok = true;
  return result;
}

// node_modules/markdown-it/lib/helpers/parse_link_title.mjs
function parseLinkTitle(str2, start3, max9, prev_state) {
  let code2;
  let pos = start3;
  const state4 = {
    // if `true`, this is a valid link title
    ok: false,
    // if `true`, this link can be continued on the next line
    can_continue: false,
    // if `ok`, it's the position of the first character after the closing marker
    pos: 0,
    // if `ok`, it's the unescaped title
    str: "",
    // expected closing marker character code
    marker: 0
  };
  if (prev_state) {
    state4.str = prev_state.str;
    state4.marker = prev_state.marker;
  } else {
    if (pos >= max9) {
      return state4;
    }
    let marker = str2.charCodeAt(pos);
    if (marker !== 34 && marker !== 39 && marker !== 40) {
      return state4;
    }
    start3++;
    pos++;
    if (marker === 40) {
      marker = 41;
    }
    state4.marker = marker;
  }
  while (pos < max9) {
    code2 = str2.charCodeAt(pos);
    if (code2 === state4.marker) {
      state4.pos = pos + 1;
      state4.str += unescapeAll(str2.slice(start3, pos));
      state4.ok = true;
      return state4;
    } else if (code2 === 40 && state4.marker === 41) {
      return state4;
    } else if (code2 === 92 && pos + 1 < max9) {
      pos++;
    }
    pos++;
  }
  state4.can_continue = true;
  state4.str += unescapeAll(str2.slice(start3, pos));
  return state4;
}

