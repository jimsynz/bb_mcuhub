// node_modules/markdown-it/lib/common/html_re.mjs
var attr_name = "[a-zA-Z_:][a-zA-Z0-9:._-]*";
var unquoted = "[^\"'=<>`\\x00-\\x20]+";
var single_quoted = "'[^']*'";
var double_quoted = '"[^"]*"';
var attr_value = "(?:" + unquoted + "|" + single_quoted + "|" + double_quoted + ")";
var attribute = "(?:\\s+" + attr_name + "(?:\\s*=\\s*" + attr_value + ")?)";
var open_tag = "<[A-Za-z][A-Za-z0-9\\-]*" + attribute + "*\\s*\\/?>";
var close_tag = "<\\/[A-Za-z][A-Za-z0-9\\-]*\\s*>";
var comment = "<!---?>|<!--(?:[^-]|-[^-]|--[^>])*-->";
var processing = "<[?][\\s\\S]*?[?]>";
var declaration = "<![A-Za-z][^>]*>";
var cdata = "<!\\[CDATA\\[[\\s\\S]*?\\]\\]>";
var HTML_TAG_RE = new RegExp("^(?:" + open_tag + "|" + close_tag + "|" + comment + "|" + processing + "|" + declaration + "|" + cdata + ")");
var HTML_OPEN_CLOSE_TAG_RE = new RegExp("^(?:" + open_tag + "|" + close_tag + ")");

// node_modules/markdown-it/lib/rules_block/html_block.mjs
var HTML_SEQUENCES = [
  [/^<(script|pre|style|textarea)(?=(\s|>|$))/i, /<\/(script|pre|style|textarea)>/i, true],
  [/^<!--/, /-->/, true],
  [/^<\?/, /\?>/, true],
  [/^<![A-Z]/, />/, true],
  [/^<!\[CDATA\[/, /\]\]>/, true],
  [new RegExp("^</?(" + html_blocks_default.join("|") + ")(?=(\\s|/?>|$))", "i"), /^$/, true],
  [new RegExp(HTML_OPEN_CLOSE_TAG_RE.source + "\\s*$"), /^$/, false]
];
function html_block(state4, startLine, endLine, silent) {
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  let max9 = state4.eMarks[startLine];
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  if (!state4.md.options.html) {
    return false;
  }
  if (state4.src.charCodeAt(pos) !== 60) {
    return false;
  }
  let lineText = state4.src.slice(pos, max9);
  let i2 = 0;
  for (; i2 < HTML_SEQUENCES.length; i2++) {
    if (HTML_SEQUENCES[i2][0].test(lineText)) {
      break;
    }
  }
  if (i2 === HTML_SEQUENCES.length) {
    return false;
  }
  if (silent) {
    return HTML_SEQUENCES[i2][2];
  }
  let nextLine = startLine + 1;
  if (!HTML_SEQUENCES[i2][1].test(lineText)) {
    for (; nextLine < endLine; nextLine++) {
      if (state4.sCount[nextLine] < state4.blkIndent) {
        break;
      }
      pos = state4.bMarks[nextLine] + state4.tShift[nextLine];
      max9 = state4.eMarks[nextLine];
      lineText = state4.src.slice(pos, max9);
      if (HTML_SEQUENCES[i2][1].test(lineText)) {
        if (lineText.length !== 0) {
          nextLine++;
        }
        break;
      }
    }
  }
  state4.line = nextLine;
  const token2 = state4.push("html_block", "", 0);
  token2.map = [startLine, nextLine];
  token2.content = state4.getLines(startLine, nextLine, state4.blkIndent, true);
  return true;
}

// node_modules/markdown-it/lib/rules_block/heading.mjs
function heading(state4, startLine, endLine, silent) {
  let pos = state4.bMarks[startLine] + state4.tShift[startLine];
  let max9 = state4.eMarks[startLine];
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  let ch = state4.src.charCodeAt(pos);
  if (ch !== 35 || pos >= max9) {
    return false;
  }
  let level = 1;
  ch = state4.src.charCodeAt(++pos);
  while (ch === 35 && pos < max9 && level <= 6) {
    level++;
    ch = state4.src.charCodeAt(++pos);
  }
  if (level > 6 || pos < max9 && !isSpace(ch)) {
    return false;
  }
  if (silent) {
    return true;
  }
  max9 = state4.skipSpacesBack(max9, pos);
  const tmp = state4.skipCharsBack(max9, 35, pos);
  if (tmp > pos && isSpace(state4.src.charCodeAt(tmp - 1))) {
    max9 = tmp;
  }
  state4.line = startLine + 1;
  const token_o = state4.push("heading_open", "h" + String(level), 1);
  token_o.markup = "########".slice(0, level);
  token_o.map = [startLine, state4.line];
  const token_i = state4.push("inline", "", 0);
  token_i.content = state4.src.slice(pos, max9).trim();
  token_i.map = [startLine, state4.line];
  token_i.children = [];
  const token_c = state4.push("heading_close", "h" + String(level), -1);
  token_c.markup = "########".slice(0, level);
  return true;
}

// node_modules/markdown-it/lib/rules_block/lheading.mjs
function lheading(state4, startLine, endLine) {
  const terminatorRules = state4.md.block.ruler.getRules("paragraph");
  if (state4.sCount[startLine] - state4.blkIndent >= 4) {
    return false;
  }
  const oldParentType = state4.parentType;
  state4.parentType = "paragraph";
  let level = 0;
  let marker;
  let nextLine = startLine + 1;
  for (; nextLine < endLine && !state4.isEmpty(nextLine); nextLine++) {
    if (state4.sCount[nextLine] - state4.blkIndent > 3) {
      continue;
    }
    if (state4.sCount[nextLine] >= state4.blkIndent) {
      let pos = state4.bMarks[nextLine] + state4.tShift[nextLine];
      const max9 = state4.eMarks[nextLine];
      if (pos < max9) {
        marker = state4.src.charCodeAt(pos);
        if (marker === 45 || marker === 61) {
          pos = state4.skipChars(pos, marker);
          pos = state4.skipSpaces(pos);
          if (pos >= max9) {
            level = marker === 61 ? 1 : 2;
            break;
          }
        }
      }
    }
    if (state4.sCount[nextLine] < 0) {
      continue;
    }
    let terminate = false;
    for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
      if (terminatorRules[i2](state4, nextLine, endLine, true)) {
        terminate = true;
        break;
      }
    }
    if (terminate) {
      break;
    }
  }
  if (!level) {
    return false;
  }
  const content = state4.getLines(startLine, nextLine, state4.blkIndent, false).trim();
  state4.line = nextLine + 1;
  const token_o = state4.push("heading_open", "h" + String(level), 1);
  token_o.markup = String.fromCharCode(marker);
  token_o.map = [startLine, state4.line];
  const token_i = state4.push("inline", "", 0);
  token_i.content = content;
  token_i.map = [startLine, state4.line - 1];
  token_i.children = [];
  const token_c = state4.push("heading_close", "h" + String(level), -1);
  token_c.markup = String.fromCharCode(marker);
  state4.parentType = oldParentType;
  return true;
}

// node_modules/markdown-it/lib/rules_block/paragraph.mjs
function paragraph(state4, startLine, endLine) {
  const terminatorRules = state4.md.block.ruler.getRules("paragraph");
  const oldParentType = state4.parentType;
  let nextLine = startLine + 1;
  state4.parentType = "paragraph";
  for (; nextLine < endLine && !state4.isEmpty(nextLine); nextLine++) {
    if (state4.sCount[nextLine] - state4.blkIndent > 3) {
      continue;
    }
    if (state4.sCount[nextLine] < 0) {
      continue;
    }
    let terminate = false;
    for (let i2 = 0, l = terminatorRules.length; i2 < l; i2++) {
      if (terminatorRules[i2](state4, nextLine, endLine, true)) {
        terminate = true;
        break;
      }
    }
    if (terminate) {
      break;
    }
  }
  const content = state4.getLines(startLine, nextLine, state4.blkIndent, false).trim();
  state4.line = nextLine;
  const token_o = state4.push("paragraph_open", "p", 1);
  token_o.map = [startLine, state4.line];
  const token_i = state4.push("inline", "", 0);
  token_i.content = content;
  token_i.map = [startLine, state4.line];
  token_i.children = [];
  state4.push("paragraph_close", "p", -1);
  state4.parentType = oldParentType;
  return true;
}

// node_modules/markdown-it/lib/parser_block.mjs
var _rules2 = [
  // First 2 params - rule name & source. Secondary array - list of rules,
  // which can be terminated by this one.
  ["table", table, ["paragraph", "reference"]],
  ["code", code],
  ["fence", fence, ["paragraph", "reference", "blockquote", "list"]],
  ["blockquote", blockquote, ["paragraph", "reference", "blockquote", "list"]],
  ["hr", hr, ["paragraph", "reference", "blockquote", "list"]],
  ["list", list, ["paragraph", "reference", "blockquote"]],
  ["reference", reference],
  ["html_block", html_block, ["paragraph", "reference", "blockquote"]],
  ["heading", heading, ["paragraph", "reference", "blockquote"]],
  ["lheading", lheading],
  ["paragraph", paragraph]
];
function ParserBlock() {
  this.ruler = new ruler_default();
  for (let i2 = 0; i2 < _rules2.length; i2++) {
    this.ruler.push(_rules2[i2][0], _rules2[i2][1], { alt: (_rules2[i2][2] || []).slice() });
  }
}
ParserBlock.prototype.tokenize = function(state4, startLine, endLine) {
  const rules = this.ruler.getRules("");
  const len = rules.length;
  const maxNesting = state4.md.options.maxNesting;
  let line2 = startLine;
  let hasEmptyLines = false;
  while (line2 < endLine) {
    state4.line = line2 = state4.skipEmptyLines(line2);
    if (line2 >= endLine) {
      break;
    }
    if (state4.sCount[line2] < state4.blkIndent) {
      break;
    }
    if (state4.level >= maxNesting) {
      state4.line = endLine;
      break;
    }
    const prevLine = state4.line;
    let ok = false;
    for (let i2 = 0; i2 < len; i2++) {
      ok = rules[i2](state4, line2, endLine, false);
      if (ok) {
        if (prevLine >= state4.line) {
          throw new Error("block rule didn't increment state.line");
        }
        break;
      }
    }
    if (!ok) throw new Error("none of the block rules matched");
    state4.tight = !hasEmptyLines;
    if (state4.isEmpty(state4.line - 1)) {
      hasEmptyLines = true;
    }
    line2 = state4.line;
    if (line2 < endLine && state4.isEmpty(line2)) {
      hasEmptyLines = true;
      line2++;
      state4.line = line2;
    }
  }
};
ParserBlock.prototype.parse = function(src, md, env, outTokens) {
  if (!src) {
    return;
  }
  const state4 = new this.State(src, md, env, outTokens);
  this.tokenize(state4, state4.line, state4.lineMax);
};
ParserBlock.prototype.State = state_block_default;
var parser_block_default = ParserBlock;

// node_modules/markdown-it/lib/rules_inline/state_inline.mjs
function StateInline(src, md, env, outTokens) {
  this.src = src;
  this.env = env;
  this.md = md;
  this.tokens = outTokens;
  this.tokens_meta = Array(outTokens.length);
  this.pos = 0;
  this.posMax = this.src.length;
  this.level = 0;
  this.pending = "";
  this.pendingLevel = 0;
  this.cache = {};
  this.delimiters = [];
  this._prev_delimiters = [];
  this.backticks = {};
  this.backticksScanned = false;
  this.linkLevel = 0;
}
StateInline.prototype.pushPending = function() {
  const token2 = new token_default("text", "", 0);
  token2.content = this.pending;
  token2.level = this.pendingLevel;
  this.tokens.push(token2);
  this.pending = "";
  return token2;
};
StateInline.prototype.push = function(type3, tag2, nesting) {
  if (this.pending) {
    this.pushPending();
  }
  const token2 = new token_default(type3, tag2, nesting);
  let token_meta = null;
  if (nesting < 0) {
    this.level--;
    this.delimiters = this._prev_delimiters.pop();
  }
  token2.level = this.level;
  if (nesting > 0) {
    this.level++;
    this._prev_delimiters.push(this.delimiters);
    this.delimiters = [];
    token_meta = { delimiters: this.delimiters };
  }
  this.pendingLevel = this.level;
  this.tokens.push(token2);
  this.tokens_meta.push(token_meta);
  return token2;
};
StateInline.prototype.scanDelims = function(start3, canSplitWord) {
  const max9 = this.posMax;
  const marker = this.src.charCodeAt(start3);
  const lastChar = start3 > 0 ? this.src.charCodeAt(start3 - 1) : 32;
  let pos = start3;
  while (pos < max9 && this.src.charCodeAt(pos) === marker) {
    pos++;
  }
  const count = pos - start3;
  const nextChar = pos < max9 ? this.src.charCodeAt(pos) : 32;
  const isLastPunctChar = isMdAsciiPunct(lastChar) || isPunctChar(String.fromCharCode(lastChar));
  const isNextPunctChar = isMdAsciiPunct(nextChar) || isPunctChar(String.fromCharCode(nextChar));
  const isLastWhiteSpace = isWhiteSpace(lastChar);
  const isNextWhiteSpace = isWhiteSpace(nextChar);
  const left_flanking = !isNextWhiteSpace && (!isNextPunctChar || isLastWhiteSpace || isLastPunctChar);
  const right_flanking = !isLastWhiteSpace && (!isLastPunctChar || isNextWhiteSpace || isNextPunctChar);
  const can_open = left_flanking && (canSplitWord || !right_flanking || isLastPunctChar);
  const can_close = right_flanking && (canSplitWord || !left_flanking || isNextPunctChar);
  return { can_open, can_close, length: count };
};
StateInline.prototype.Token = token_default;
var state_inline_default = StateInline;

// node_modules/markdown-it/lib/rules_inline/text.mjs
function isTerminatorChar(ch) {
  switch (ch) {
    case 10:
    case 33:
    case 35:
    case 36:
    case 37:
    case 38:
    case 42:
    case 43:
    case 45:
    case 58:
    case 60:
    case 61:
    case 62:
    case 64:
    case 91:
    case 92:
    case 93:
    case 94:
    case 95:
    case 96:
    case 123:
    case 125:
    case 126:
      return true;
    default:
      return false;
  }
}
function text(state4, silent) {
  let pos = state4.pos;
  while (pos < state4.posMax && !isTerminatorChar(state4.src.charCodeAt(pos))) {
    pos++;
  }
  if (pos === state4.pos) {
    return false;
  }
  if (!silent) {
    state4.pending += state4.src.slice(state4.pos, pos);
  }
  state4.pos = pos;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/linkify.mjs
var SCHEME_RE = /(?:^|[^a-z0-9.+-])([a-z][a-z0-9.+-]*)$/i;
function linkify2(state4, silent) {
  if (!state4.md.options.linkify) return false;
  if (state4.linkLevel > 0) return false;
  const pos = state4.pos;
  const max9 = state4.posMax;
  if (pos + 3 > max9) return false;
  if (state4.src.charCodeAt(pos) !== 58) return false;
  if (state4.src.charCodeAt(pos + 1) !== 47) return false;
  if (state4.src.charCodeAt(pos + 2) !== 47) return false;
  const match3 = state4.pending.match(SCHEME_RE);
  if (!match3) return false;
  const proto = match3[1];
  const link3 = state4.md.linkify.matchAtStart(state4.src.slice(pos - proto.length));
  if (!link3) return false;
  let url = link3.url;
  if (url.length <= proto.length) return false;
  url = url.replace(/\*+$/, "");
  const fullUrl = state4.md.normalizeLink(url);
  if (!state4.md.validateLink(fullUrl)) return false;
  if (!silent) {
    state4.pending = state4.pending.slice(0, -proto.length);
    const token_o = state4.push("link_open", "a", 1);
    token_o.attrs = [["href", fullUrl]];
    token_o.markup = "linkify";
    token_o.info = "auto";
    const token_t = state4.push("text", "", 0);
    token_t.content = state4.md.normalizeLinkText(url);
    const token_c = state4.push("link_close", "a", -1);
    token_c.markup = "linkify";
    token_c.info = "auto";
  }
  state4.pos += url.length - proto.length;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/newline.mjs
function newline(state4, silent) {
  let pos = state4.pos;
  if (state4.src.charCodeAt(pos) !== 10) {
    return false;
  }
  const pmax = state4.pending.length - 1;
  const max9 = state4.posMax;
  if (!silent) {
    if (pmax >= 0 && state4.pending.charCodeAt(pmax) === 32) {
      if (pmax >= 1 && state4.pending.charCodeAt(pmax - 1) === 32) {
        let ws = pmax - 1;
        while (ws >= 1 && state4.pending.charCodeAt(ws - 1) === 32) ws--;
        state4.pending = state4.pending.slice(0, ws);
        state4.push("hardbreak", "br", 0);
      } else {
        state4.pending = state4.pending.slice(0, -1);
        state4.push("softbreak", "br", 0);
      }
    } else {
      state4.push("softbreak", "br", 0);
    }
  }
  pos++;
  while (pos < max9 && isSpace(state4.src.charCodeAt(pos))) {
    pos++;
  }
  state4.pos = pos;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/escape.mjs
var ESCAPED = [];
for (let i2 = 0; i2 < 256; i2++) {
  ESCAPED.push(0);
}
"\\!\"#$%&'()*+,./:;<=>?@[]^_`{|}~-".split("").forEach(function(ch) {
  ESCAPED[ch.charCodeAt(0)] = 1;
});
function escape3(state4, silent) {
  let pos = state4.pos;
  const max9 = state4.posMax;
  if (state4.src.charCodeAt(pos) !== 92) return false;
  pos++;
  if (pos >= max9) return false;
  let ch1 = state4.src.charCodeAt(pos);
  if (ch1 === 10) {
    if (!silent) {
      state4.push("hardbreak", "br", 0);
    }
    pos++;
    while (pos < max9) {
      ch1 = state4.src.charCodeAt(pos);
      if (!isSpace(ch1)) break;
      pos++;
    }
    state4.pos = pos;
    return true;
  }
  let escapedStr = state4.src[pos];
  if (ch1 >= 55296 && ch1 <= 56319 && pos + 1 < max9) {
    const ch2 = state4.src.charCodeAt(pos + 1);
    if (ch2 >= 56320 && ch2 <= 57343) {
      escapedStr += state4.src[pos + 1];
      pos++;
    }
  }
  const origStr = "\\" + escapedStr;
  if (!silent) {
    const token2 = state4.push("text_special", "", 0);
    if (ch1 < 256 && ESCAPED[ch1] !== 0) {
      token2.content = escapedStr;
    } else {
      token2.content = origStr;
    }
    token2.markup = origStr;
    token2.info = "escape";
  }
  state4.pos = pos + 1;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/backticks.mjs
function backtick(state4, silent) {
  let pos = state4.pos;
  const ch = state4.src.charCodeAt(pos);
  if (ch !== 96) {
    return false;
  }
  const start3 = pos;
  pos++;
  const max9 = state4.posMax;
  while (pos < max9 && state4.src.charCodeAt(pos) === 96) {
    pos++;
  }
  const marker = state4.src.slice(start3, pos);
  const openerLength = marker.length;
  if (state4.backticksScanned && (state4.backticks[openerLength] || 0) <= start3) {
    if (!silent) state4.pending += marker;
    state4.pos += openerLength;
    return true;
  }
  let matchEnd = pos;
  let matchStart;
  while ((matchStart = state4.src.indexOf("`", matchEnd)) !== -1) {
    matchEnd = matchStart + 1;
    while (matchEnd < max9 && state4.src.charCodeAt(matchEnd) === 96) {
      matchEnd++;
    }
    const closerLength = matchEnd - matchStart;
    if (closerLength === openerLength) {
      if (!silent) {
        const token2 = state4.push("code_inline", "code", 0);
        token2.markup = marker;
        token2.content = state4.src.slice(pos, matchStart).replace(/\n/g, " ").replace(/^ (.+) $/, "$1");
      }
      state4.pos = matchEnd;
      return true;
    }
    state4.backticks[closerLength] = matchStart;
  }
  state4.backticksScanned = true;
  if (!silent) state4.pending += marker;
  state4.pos += openerLength;
  return true;
}

// node_modules/markdown-it/lib/rules_inline/strikethrough.mjs
function strikethrough_tokenize(state4, silent) {
  const start3 = state4.pos;
  const marker = state4.src.charCodeAt(start3);
  if (silent) {
    return false;
  }
  if (marker !== 126) {
    return false;
  }
  const scanned = state4.scanDelims(state4.pos, true);
  let len = scanned.length;
  const ch = String.fromCharCode(marker);
  if (len < 2) {
    return false;
  }
  let token2;
  if (len % 2) {
    token2 = state4.push("text", "", 0);
    token2.content = ch;
    len--;
  }
  for (let i2 = 0; i2 < len; i2 += 2) {
    token2 = state4.push("text", "", 0);
    token2.content = ch + ch;
    state4.delimiters.push({
      marker,
      length: 0,
      // disable "rule of 3" length checks meant for emphasis
      token: state4.tokens.length - 1,
      end: -1,
      open: scanned.can_open,
      close: scanned.can_close
    });
  }
  state4.pos += scanned.length;
  return true;
}
function postProcess(state4, delimiters2) {
  let token2;
  const loneMarkers = [];
  const max9 = delimiters2.length;
  for (let i2 = 0; i2 < max9; i2++) {
    const startDelim = delimiters2[i2];
    if (startDelim.marker !== 126) {
      continue;
    }
    if (startDelim.end === -1) {
      continue;
    }
    const endDelim = delimiters2[startDelim.end];
    token2 = state4.tokens[startDelim.token];
    token2.type = "s_open";
    token2.tag = "s";
    token2.nesting = 1;
    token2.markup = "~~";
    token2.content = "";
    token2 = state4.tokens[endDelim.token];
    token2.type = "s_close";
    token2.tag = "s";
    token2.nesting = -1;
    token2.markup = "~~";
    token2.content = "";
    if (state4.tokens[endDelim.token - 1].type === "text" && state4.tokens[endDelim.token - 1].content === "~") {
      loneMarkers.push(endDelim.token - 1);
    }
  }
  while (loneMarkers.length) {
    const i2 = loneMarkers.pop();
    let j = i2 + 1;
    while (j < state4.tokens.length && state4.tokens[j].type === "s_close") {
      j++;
    }
    j--;
    if (i2 !== j) {
      token2 = state4.tokens[j];
      state4.tokens[j] = state4.tokens[i2];
      state4.tokens[i2] = token2;
    }
  }
}
function strikethrough_postProcess(state4) {
  const tokens_meta = state4.tokens_meta;
  const max9 = state4.tokens_meta.length;
  postProcess(state4, state4.delimiters);
  for (let curr = 0; curr < max9; curr++) {
    if (tokens_meta[curr] && tokens_meta[curr].delimiters) {
      postProcess(state4, tokens_meta[curr].delimiters);
    }
  }
}
var strikethrough_default = {
  tokenize: strikethrough_tokenize,
  postProcess: strikethrough_postProcess
};

// node_modules/markdown-it/lib/rules_inline/emphasis.mjs
function emphasis_tokenize(state4, silent) {
  const start3 = state4.pos;
  const marker = state4.src.charCodeAt(start3);
  if (silent) {
    return false;
  }
  if (marker !== 95 && marker !== 42) {
    return false;
  }
  const scanned = state4.scanDelims(state4.pos, marker === 42);
  for (let i2 = 0; i2 < scanned.length; i2++) {
    const token2 = state4.push("text", "", 0);
    token2.content = String.fromCharCode(marker);
    state4.delimiters.push({
      // Char code of the starting marker (number).
      //
      marker,
      // Total length of these series of delimiters.
      //
      length: scanned.length,
      // A position of the token this delimiter corresponds to.
      //
      token: state4.tokens.length - 1,
      // If this delimiter is matched as a valid opener, `end` will be
      // equal to its position, otherwise it's `-1`.
      //
      end: -1,
      // Boolean flags that determine if this delimiter could open or close
      // an emphasis.
      //
      open: scanned.can_open,
      close: scanned.can_close
    });
  }
  state4.pos += scanned.length;
  return true;
}
function postProcess2(state4, delimiters2) {
  const max9 = delimiters2.length;
  for (let i2 = max9 - 1; i2 >= 0; i2--) {
    const startDelim = delimiters2[i2];
    if (startDelim.marker !== 95 && startDelim.marker !== 42) {
      continue;
    }
    if (startDelim.end === -1) {
      continue;
    }
    const endDelim = delimiters2[startDelim.end];
    const isStrong = i2 > 0 && delimiters2[i2 - 1].end === startDelim.end + 1 && // check that first two markers match and adjacent
    delimiters2[i2 - 1].marker === startDelim.marker && delimiters2[i2 - 1].token === startDelim.token - 1 && // check that last two markers are adjacent (we can safely assume they match)
    delimiters2[startDelim.end + 1].token === endDelim.token + 1;
    const ch = String.fromCharCode(startDelim.marker);
    const token_o = state4.tokens[startDelim.token];
    token_o.type = isStrong ? "strong_open" : "em_open";
    token_o.tag = isStrong ? "strong" : "em";
    token_o.nesting = 1;
    token_o.markup = isStrong ? ch + ch : ch;
    token_o.content = "";
    const token_c = state4.tokens[endDelim.token];
    token_c.type = isStrong ? "strong_close" : "em_close";
    token_c.tag = isStrong ? "strong" : "em";
    token_c.nesting = -1;
    token_c.markup = isStrong ? ch + ch : ch;
    token_c.content = "";
    if (isStrong) {
      state4.tokens[delimiters2[i2 - 1].token].content = "";
      state4.tokens[delimiters2[startDelim.end + 1].token].content = "";
      i2--;
    }
  }
}
function emphasis_post_process(state4) {
  const tokens_meta = state4.tokens_meta;
  const max9 = state4.tokens_meta.length;
  postProcess2(state4, state4.delimiters);
  for (let curr = 0; curr < max9; curr++) {
    if (tokens_meta[curr] && tokens_meta[curr].delimiters) {
      postProcess2(state4, tokens_meta[curr].delimiters);
    }
  }
}
var emphasis_default = {
  tokenize: emphasis_tokenize,
  postProcess: emphasis_post_process
};

// node_modules/markdown-it/lib/rules_inline/link.mjs
function link(state4, silent) {
  let code2, label, res, ref;
  let href = "";
  let title2 = "";
  let start3 = state4.pos;
  let parseReference = true;
  if (state4.src.charCodeAt(state4.pos) !== 91) {
    return false;
  }
  const oldPos = state4.pos;
  const max9 = state4.posMax;
  const labelStart = state4.pos + 1;
  const labelEnd = state4.md.helpers.parseLinkLabel(state4, state4.pos, true);
  if (labelEnd < 0) {
    return false;
  }
  let pos = labelEnd + 1;
  if (pos < max9 && state4.src.charCodeAt(pos) === 40) {
    parseReference = false;
    pos++;
    for (; pos < max9; pos++) {
      code2 = state4.src.charCodeAt(pos);
      if (!isSpace(code2) && code2 !== 10) {
        break;
      }
    }
    if (pos >= max9) {
      return false;
    }
    start3 = pos;
    res = state4.md.helpers.parseLinkDestination(state4.src, pos, state4.posMax);
    if (res.ok) {
      href = state4.md.normalizeLink(res.str);
      if (state4.md.validateLink(href)) {
        pos = res.pos;
      } else {
        href = "";
      }
      start3 = pos;
      for (; pos < max9; pos++) {
        code2 = state4.src.charCodeAt(pos);
        if (!isSpace(code2) && code2 !== 10) {
          break;
        }
      }
      res = state4.md.helpers.parseLinkTitle(state4.src, pos, state4.posMax);
      if (pos < max9 && start3 !== pos && res.ok) {
        title2 = res.str;
        pos = res.pos;
        for (; pos < max9; pos++) {
          code2 = state4.src.charCodeAt(pos);
          if (!isSpace(code2) && code2 !== 10) {
            break;
          }
        }
      }
    }
    if (pos >= max9 || state4.src.charCodeAt(pos) !== 41) {
      parseReference = true;
    }
    pos++;
  }
  if (parseReference) {
    if (typeof state4.env.references === "undefined") {
      return false;
    }
    if (pos < max9 && state4.src.charCodeAt(pos) === 91) {
      start3 = pos + 1;
      pos = state4.md.helpers.parseLinkLabel(state4, pos);
      if (pos >= 0) {
        label = state4.src.slice(start3, pos++);
      } else {
        pos = labelEnd + 1;
      }
    } else {
      pos = labelEnd + 1;
    }
    if (!label) {
      label = state4.src.slice(labelStart, labelEnd);
    }
    ref = state4.env.references[normalizeReference(label)];
    if (!ref) {
      state4.pos = oldPos;
      return false;
    }
    href = ref.href;
    title2 = ref.title;
  }
  if (!silent) {
    state4.pos = labelStart;
    state4.posMax = labelEnd;
    const token_o = state4.push("link_open", "a", 1);
    const attrs = [["href", href]];
    token_o.attrs = attrs;
    if (title2) {
      attrs.push(["title", title2]);
    }
    state4.linkLevel++;
    state4.md.inline.tokenize(state4);
    state4.linkLevel--;
    state4.push("link_close", "a", -1);
  }
  state4.pos = pos;
  state4.posMax = max9;
  return true;
}

