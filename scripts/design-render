    simplified.setEdge(e, g.edge(e));
  });
  return simplified;
}
function intersectRect2(rect3, point8) {
  var x3 = rect3.x;
  var y3 = rect3.y;
  var dx = point8.x - x3;
  var dy = point8.y - y3;
  var w2 = rect3.width / 2;
  var h = rect3.height / 2;
  if (!dx && !dy) {
    throw new Error("Not possible to find intersection inside of the rectangle");
  }
  var sx, sy;
  if (Math.abs(dy) * w2 > Math.abs(dx) * h) {
    if (dy < 0) {
      h = -h;
    }
    sx = h * dx / dy;
    sy = h;
  } else {
    if (dx < 0) {
      w2 = -w2;
    }
    sx = w2;
    sy = w2 * dy / dx;
  }
  return { x: x3 + sx, y: y3 + sy };
}
