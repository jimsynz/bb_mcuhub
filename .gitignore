# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
bb_mcuhub-*.tar

# Temporary files, for example, from tests.
/tmp/

# C harness binaries (host-compiled)
/firmware/test/parity_harness
/firmware/test/floor_harness
/firmware/test/router_harness
/firmware/test/segment_harness
/firmware/test/uart_backplane_harness
*.o

# PlatformIO
.pio/

# pio venv
/.pio-venv/
.pio-core

# direnv / nix devShell
.direnv/

# Example apps (downstream consumers under examples/) — their Mix build/dep dirs.
# The root /_build and /deps above are anchored to the library root, so the
# example's own ones need their own (unanchored) entries.
examples/*/_build/
examples/*/deps/
examples/*/cover/
examples/*/doc/
